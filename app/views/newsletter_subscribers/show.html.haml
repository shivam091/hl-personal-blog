- subscriber = @newsletter_subscriber
- messages = subscriber.messages.to_a
- content_for :title, "#{subscriber.email} – Subscribers"

= link_to newsletter_subscribers_path, class: "mb-4 inline-flex items-center gap-1.5 text-sm font-medium text-slate-600 hover:text-slate-900" do
  = icon("arrow-left")
  Subscribers

%div{class: page_header_class}
  %div
    %h1{class: "text-xl font-semibold tracking-tight break-all"}= subscriber.email
    - if subscriber.subscribed_at
      %p{class: subtitle_class}
        Subscribed
        = time_tag(subscriber.subscribed_at)
  = mail_to subscriber.email,
    class: outline_button_class do
    = icon("send", size: 14)
    Email

%div{class: "grid gap-6 lg:grid-cols-3"}
  = render "shared/details", id: "subscriber", title: "Subscriber", icon: "users", rows: newsletter_subscriber_rows(subscriber)
  %div{class: "lg:col-span-2"}
    = render layout: "shared/card", locals: {id: "messages", title: "Messages sent", icon: "message-square"} do
      - if messages.empty?
        %p{class: empty_note_class} No messages from this subscriber.
      - else
        = render "messages/message_list", messages: messages
