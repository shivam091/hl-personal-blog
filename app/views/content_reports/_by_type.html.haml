%div{class: "overflow-x-auto"}
  %table{class: table_class}
    %thead{class: "text-slate-500"}
      %tr
        %th{scope: "col", class: "#{th_class} text-left"} Type
        %th{scope: "col", class: "#{th_class} text-right"} Entries
        %th{scope: "col", class: "#{th_class} text-right", title: "Published in the period"}<
          New
        %th{scope: "col", class: "#{th_class} text-right"} Views
        %th{scope: "col", class: "#{th_class} text-right", title: "Views in the period per entry"}<
          Per entry
        %th{scope: "col", class: "#{th_class} text-right"} Likes
        %th{scope: "col", class: "#{th_class} text-right"} Clicks
        -# Google's totals over the latest upload's range, not the period's,
        -# so the range is given where they're headed.
        - if ai.covered
          %th{scope: "col", class: "#{th_class} text-right", title: "Google's total for #{l(ai.covered.begin)} – #{l(ai.covered.end)}, from the latest Generative AI upload"}<
            AI impressions
    %tbody
      - rows.each do |row|
        %tr{class: "border-t border-slate-200"}
          %td{class: "px-3 py-1.5 font-medium"}= row[:type].pluralize.capitalize
          %td{class: "px-3 py-1.5 text-right tabular-nums"}= number_with_delimiter(row[:entries])
          %td{class: "px-3 py-1.5 text-right tabular-nums"}= number_with_delimiter(row[:published])
          %td{class: "px-3 py-1.5 text-right tabular-nums"}= number_with_delimiter(row[:views])
          %td{class: "px-3 py-1.5 text-right tabular-nums"}<
            - if row[:average_views]
              = number_with_precision(row[:average_views], precision: 1, delimiter: ",")
            - else
              \—
          %td{class: "px-3 py-1.5 text-right tabular-nums"}= number_with_delimiter(row[:likes])
          %td{class: "px-3 py-1.5 text-right tabular-nums"}= number_with_delimiter(row[:clicks])
          - if ai.covered
            %td{class: "px-3 py-1.5 text-right tabular-nums"}= number_with_delimiter(ai_by_type.fetch(row[:type], 0))
