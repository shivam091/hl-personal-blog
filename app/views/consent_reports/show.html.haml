- content_for :title, "Consent report"
- consent = @consent
- total = consent.total
- states = consent.views_by_state

%div{class: page_header_class}
  %div
    %h1{class: page_title_class} Consent report
    %p{class: subtitle_class}
      What readers answered the cookie banner, and how much of the gap between page views and GA's it explains.
  %div{class: "flex flex-wrap gap-2"}
    = link_to consent_page_gap_report_path(**@period.query), class: outline_button_class do
      = icon("table", size: 14)
      Page gaps
    = link_to list_url(@period, @filtering, format: :csv),
      class: outline_button_class do
      = icon("download", size: 14)
      Export CSV

= render "shared/stats_filters", stats: @stats, period: @period, filtering: @filtering, keep: [@granularity_state]

- notes = []
- notes << "The banner has been recorded since #{l(consent.recording_since)}; earlier days show none." if consent.recording_since && consent.recording_since > @period.from
- notes << "Views have been split by consent since #{l(consent.views_tracked_since)}; earlier days are left out of the views below." if consent.views_tracked_since && consent.views_tracked_since > @period.from
- notes << "Whether GA's tag loaded has been recorded since #{l(consent.ga_first_day)}; the causes below that depend on it leave out earlier days." if consent.ga_first_day && consent.ga_first_day > @period.from
- notes << "Suspected automation has been recorded since #{l(consent.suspects_first_day)}; earlier days can't show datacentre traffic." if consent.suspects_first_day && consent.suspects_first_day > @period.from
- notes << "Consent isn't split by country on views, so those figures cover every country." if @stats.country
= render "shared/period_notes", notes: notes

- before = @consent_before&.total
- gap_before = @gap_before
- higher, lower = DashboardHelper::HIGHER_IS_BETTER, DashboardHelper::LOWER_IS_BETTER
-# The change leads, as it's what a comparison is opened for; what the figure is a share of follows as context.
- lines = ->(*parts) { safe_join(parts.compact, tag.span(" · ", class: "text-slate-400")) if parts.compact.any? }
%dl{class: "mb-6 grid grid-cols-2 gap-3 lg:grid-cols-4"}
  = render "dashboard/tile", label: "Banner shown", tile_icon: "eye", value: number_with_delimiter(total.shown),
    change: metric_change(total.shown, before&.shown, higher), compared_with: @previous_name,
    hint: "Times the banner appeared, once per browser session. Only readers in the EEA, UK and Switzerland are asked."
  = render "dashboard/tile", label: "Accepted", tile_icon: "check", value: number_with_delimiter(total.granted),
    change: lines.(metric_change(total.granted, before&.granted, higher),
      (number_to_percentage(total.acceptance_rate * 100, precision: 1) + " of answers" if total.acceptance_rate)),
    compared_with: @previous_name, hint: "Readers who chose Accept."
  = render "dashboard/tile", label: "Declined", tile_icon: "x", value: number_with_delimiter(total.denied),
    change: metric_change(total.denied, before&.denied, lower), compared_with: @previous_name,
    hint: "Readers who chose Decline. GA counts their views only as unnamed, unmodelled pings."
  = render "dashboard/tile", label: "No answer", tile_icon: "clock", value: number_with_delimiter(total.no_answer),
    change: lines.(metric_change(total.no_answer, before&.no_answer, lower),
      ("#{number_with_delimiter(total.changed)} changed their mind" if total.changed.positive?)),
    compared_with: @previous_name, hint: "Banners shown that were closed or left without a choice. Analytics stays denied for them."

- if @gap
  %dl{class: "mb-6 grid grid-cols-2 gap-3 lg:grid-cols-4"}
    = render "dashboard/tile", label: "Our views", tile_icon: "eye", value: number_with_delimiter(@gap.first_party),
      change: metric_change(@gap.first_party, gap_before&.first_party, higher), compared_with: @previous_name,
      hint: "Page views counted by the blog itself on the days GA has synced and consent was recorded."
    = render "dashboard/tile", label: "GA views", tile_icon: "bar-chart", value: number_with_delimiter(@gap.analytics),
      change: metric_change(@gap.analytics, gap_before&.analytics, higher), compared_with: @previous_name,
      hint: "The same days in Google Analytics."
    -# A gap at or below zero, GA counting as many as us or more, has no percentage change to read from it, so the earlier figure is given instead.
    - was = ->(current, earlier, metric) do
      - next metric_change(current, earlier, metric) unless gap_before && !gap_before.difference.positive?
      - tag.span("Was #{number_with_delimiter(earlier)}", class: "text-slate-500", title: "GA counted at least as many views as we did in #{@previous_name}")
    = render "dashboard/tile", label: "Gap", tile_icon: "alert-triangle", value: number_with_delimiter(@gap.difference),
      change: lines.(was.(@gap.difference, gap_before&.difference, lower),
        (number_to_percentage(@gap.percent * 100, precision: 1) + " of our views" if @gap.percent)),
      compared_with: @previous_name, hint: "Our views minus GA's."
    = render "dashboard/tile", label: "Explained by declines", tile_icon: "cookie", value: number_with_delimiter(@gap.explained),
      change: lines.(was.(@gap.explained, gap_before&.explained, higher),
        (number_to_percentage(@gap.explained_share * 100, precision: 1) + " of the gap" if @gap.explained_share)),
      compared_with: @previous_name,
      hint: "Views from readers who declined, up to the size of the gap. The rest is ad blockers, bots and GA's own filtering."

- if @decomposition&.any?
  - decomposition = @decomposition
  = render layout: "shared/card", locals: {id: "gap-causes", title: "Where the gap goes", icon: "split", class: "mb-6"} do
    %p{class: lead_note_class}
      Our views minus GA's over the #{pluralize(decomposition.days.size, "day")} with the consent split recorded, put down to what is known about each reader.
      Blocked, undetected and datacentre views count only for readers GA could otherwise have seen, so a declined reader isn't counted twice.
    = report_table([report_th("Cause"), report_th("Views", :right), report_th("Share of gap", :right)]) do
      - ConsentGap::CAUSES.each do |cause, label|
        %tr{class: table_row_class}
          %td{class: title_cell_class}= label
          %td{class: cell_class}= number_with_delimiter(decomposition.sum(cause))
          %td{class: cell_class}= decomposition.share_of_gap(cause) ? number_to_percentage(decomposition.share_of_gap(cause) * 100, precision: 1) : "—"
      %tr{class: [table_row_class, "font-semibold"]}
        %td{class: title_cell_class} Unexplained
        %td{class: cell_class}= number_with_delimiter(decomposition.remainder)
        %td{class: cell_class}= decomposition.remainder_share ? number_to_percentage(decomposition.remainder_share * 100, precision: 1) : "—"
    %p{class: footnote_class}
      - if decomposition.over_counted?
        The causes found add up to more than the gap, so GA is counting more views than they leave room for. Treat the unexplained figure as zero.
      - else
        What is left is bots our rough check missed, GA filtering bots it knows, and views lost to timing.
      - missing = decomposition.days_missing(:ga_recorded)
      - if missing.positive?
        #{pluralize(missing, "day")} had no record of whether the tag loaded, so blocked and undetected views read lower than they were.
  = render "consent_reports/causes_over_time", decomposition: decomposition, granularity: @granularity, period: @period,
    before: @decomposition_before, previous: @previous, previous_name: @previous_name
  = render layout: "shared/card", locals: {id: "unexplained-by-day", title: "Unexplained gap, by day", icon: "trending-up", class: "mb-6"} do
    = report_table([report_th("Date"), report_th("Gap", :right), report_th("Declined", :right), report_th("Pending", :right), report_th("Blocked", :right),
      report_th("Undetected", :right), report_th("Datacentre", :right), report_th("Unexplained", :right)]) do
      - decomposition.days.first(31).each do |day|
        %tr{class: table_row_class}
          %td{class: "px-3 py-1.5 whitespace-nowrap"}= day_label(day.day)
          %td{class: cell_class}= number_with_delimiter(day.gap)
          - ConsentGap::CAUSES.each_key do |cause|
            %td{class: cell_class}= day.public_send(cause).nil? ? "—" : number_with_delimiter(day.public_send(cause))
          %td{class: cell_class}= number_with_delimiter(day.remainder)
- elsif consent.any? || states.any?
  %p{class: "mb-6 text-sm text-slate-500"}
    - if @analytics.any?
      GA has no figures for a day in #{@period} with the consent split recorded, so the gap can't be put down to causes.
    - else
      GA hasn't synced, so the gap can't be put down to causes yet.

- health = @health
- health_before = @health_before
- if health.shown.positive? || health.pending_views.positive? || health.unknown_country_views.positive?
  = render layout: "shared/card", locals: {id: "banner-health", title: "Banner health", icon: "heart-pulse", class: "mb-6"} do
    = report_table([report_th("Check"), report_th("Figure", :right), report_th("What it means")]) do
      %tr{class: table_row_class}
        %td{class: "px-3 py-1.5 whitespace-nowrap"} Banners shown
        %td{class: cell_class}
          = number_with_delimiter(health.shown)
          = row_change(health.shown, health_before.shown, higher) if health_before
        %td{class: "px-3 py-1.5 text-slate-600"} One per browser session.
      %tr{class: table_row_class}
        %td{class: "px-3 py-1.5 whitespace-nowrap"} Views while the banner was due
        %td{class: cell_class}
          = number_with_delimiter(health.pending_views)
          = row_change(health.pending_views, health_before.pending_views, lower) if health_before
        %td{class: "px-3 py-1.5 text-slate-600"} From readers in the EEA, UK or Switzerland who hadn't answered.
      %tr{class: table_row_class}
        %td{class: "px-3 py-1.5 whitespace-nowrap"} Such views per banner
        %td{class: cell_class}
          = health.pending_per_banner ? number_with_delimiter(health.pending_per_banner.round(1)) : "—"
          = row_change(health.pending_per_banner, health_before.pending_per_banner, lower) if health_before&.pending_per_banner && health.pending_per_banner
        %td{class: "px-3 py-1.5 text-slate-600"} A few pages per session is normal; a figure that keeps climbing means the banner stopped appearing.
      %tr{class: table_row_class}
        %td{class: "px-3 py-1.5 whitespace-nowrap"} Views with no country
        %td{class: cell_class}
          = health.unknown_country_share ? number_to_percentage(health.unknown_country_share * 100, precision: 1) : "—"
          = row_change(health.unknown_country_share, health_before.unknown_country_share, lower) if health_before&.unknown_country_share && health.unknown_country_share
        %td{class: "px-3 py-1.5 text-slate-600"} These readers were never asked, as the banner needs a country, so a high share is a gap in consent too.

- if consent.any? || states.any?
  %div{class: split_grid_class}
    = render "consent_reports/banner_funnel", total: total, period: @period, before: before, previous_name: @previous_name
    = render layout: "shared/card", locals: {id: "views-by-consent", title: "Views by consent state", icon: "eye"} do
      - if consent.tracked_views.zero?
        %p{class: empty_note_class} No views split by consent in #{@period}.
      - else
        %div{class: "px-4 py-3"}
          - named = ->(counts) { ConsentStats::STATE_NAMES.to_h { |state, name| [name, counts[state]] } }
          = donut_chart(named.(states), label: "Views by the reader's consent state", unit: "view", empty: "No views split by consent in #{@period}.")
          = donut_comparison(named.(states), named.(@states_before), unit: "view", previous_name: @previous_name) if @states_before
        %details{class: "border-t border-slate-100"}
          %summary{class: "cursor-pointer px-4 py-2 text-xs font-medium text-slate-500 hover:text-slate-900"} Every state, with what it means
          = report_table([report_th("State"), report_th("Views", :right), report_th("Share", :right)]) do
            - {"granted" => "Accepted", "denied" => "Declined", "pending" => "Banner due, not yet answered", "default" => "No banner needed", "unset" => "Unknown (before pending/default split)"}.each do |state, label|
              %tr{class: table_row_class}
                %td{class: title_cell_class}= label
                %td{class: cell_class}= number_with_delimiter(states[state])
                %td{class: cell_class}= number_to_percentage(states[state] * 100.0 / consent.tracked_views, precision: 1)
  = render "consent_reports/banner_by_country", rows: consent.countries, period: @period,
    before: (@consent_before.countries if @consent_before && !@period.compare_countries?), previous_name: @previous_name

  - if @gap && @gap.days.any?
    = render "consent_reports/views_against_ga", gap: @gap, first_party: @first_party_views, analytics: @analytics_views,
      published: @published, granularity: @granularity, period: @period, previous: (@previous if @gap_before), previous_name: @previous_name,
      first_party_before: @first_party_before, analytics_before: @analytics_before
- else
  = render "shared/empty_state", message: "No consent answers or consent-split views recorded in #{@period}."
