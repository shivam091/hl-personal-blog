- content_for :title, "Data quality"
- dates = (@period.from..@period.to).to_a
- own_total = @stats.total(:views)
- ga_total = @analytics.views
- table_class = "w-full border-collapse text-sm"
- th_class = "px-3 py-1.5 font-medium whitespace-nowrap"

%div{class: "mb-6 flex flex-wrap items-start justify-between gap-3"}
  %div
    %h1{class: "text-2xl font-semibold tracking-tight"} Data quality
    %p{class: "mt-1 text-sm text-slate-500"}
      How far the figures agree, which days are missing, and how fresh each source is.
  = link_to list_url(@period, @filtering, format: :csv),
    class: "inline-flex items-center gap-1.5 rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 shadow-sm hover:bg-slate-50" do
    = icon("download", size: 14)
    Export page comparison

= render "shared/stats_filters", stats: @stats, period: @period, filtering: @filtering, keep: [], likes_note: false, compare: false

%div{class: "mb-6"}
  = render layout: "shared/card", locals: {id: "own-vs-ga", title: "Blog views against Google Analytics", icon: "activity"} do
    %div{class: "px-4 py-3"}
      %p{class: "mb-3 text-sm text-slate-600"}
        #{number_with_delimiter(own_total)} counted by the blog, #{number_with_delimiter(ga_total)}
        by Google Analytics
        - if own_total.positive? && @analytics.any?
          (GA sees #{number_to_percentage(ga_total * 100.0 / own_total, precision: 1)} of them).
      = line_chart(dates, [ChartsHelper::Series.new(name: "Blog's own count", values: @stats.daily(:views)),
        ChartsHelper::Series.new(name: "Google Analytics", values: @analytics.daily_views, dashed: true)],
        y_title: "Views", label: "The blog's own views against Google Analytics views, per day")
    %p{class: "border-t border-slate-200 px-4 py-2 text-xs text-slate-500"}
      GA misses readers who block its script, and the blog leaves out hits it takes for bots, so neither count
      is the whole truth; a gap that suddenly widens is the thing to look into.

%div{class: "mb-6 grid items-start gap-6 lg:grid-cols-2"}
  = render layout: "shared/card", locals: {id: "page-comparison", title: "By page", icon: "file"} do
    - if @rows.empty?
      %p{class: "px-4 py-3 text-sm text-slate-500"} No views in this period.
    - else
      %div{class: "overflow-x-auto"}
        %table{class: table_class}
          %thead{class: "text-slate-500"}
            %tr
              %th{scope: "col", class: "#{th_class} text-left"} Page
              %th{scope: "col", class: "#{th_class} text-right"} Blog
              %th{scope: "col", class: "#{th_class} text-right"} GA
              %th{scope: "col", class: "#{th_class} text-right", title: "GA's count against the blog's"} Difference
          %tbody
            - @rows.first(15).each do |path, blog, google, difference|
              %tr{class: "border-t border-slate-200"}
                %td{class: "w-full px-3 py-1.5"}
                  = blog_page_link(path, page_view_path(path))
                %td{class: "px-3 py-1.5 text-right tabular-nums"}= number_with_delimiter(blog)
                %td{class: "px-3 py-1.5 text-right tabular-nums"}= number_with_delimiter(google)
                %td{class: "px-3 py-1.5 text-right tabular-nums"}
                  - if difference
                    %span{class: difference.abs > 0.5 ? "font-medium text-amber-700" : "text-slate-600"}
                      #{difference.negative? ? "−" : "+"}#{number_to_percentage(difference.abs * 100, precision: 0)}
                  - else
                    %span{class: "text-slate-400"} GA only

  %div{class: "grid gap-6"}
    -# One cell per day, so a gap in an import is seen at a glance rather
    -# than inferred from a dip in a chart.
    = render layout: "shared/card", locals: {id: "coverage", title: "Days with data", icon: "calendar"} do
      - sources = {"Blog views" => @stats.daily(:views).each_with_index.filter_map { |count, index| dates[index] if count.positive? },
        "Search Console" => @search.days_with_data, "Google Analytics" => @analytics.days_with_data,
        "reCAPTCHA" => Google::Recaptcha::Stat.where(date: @period.from..@period.to).distinct(:date).map(&:to_date)}
      %div{class: "space-y-3 px-4 py-3"}
        - sources.each do |name, present|
          - present = present.to_set
          - missing = dates.count { |date| !present.include?(date) }
          %div
            %p{class: "mb-1 flex justify-between text-xs"}
              %span{class: "font-medium text-slate-700"}= name
              %span{class: missing.zero? ? "text-emerald-700" : "text-amber-700"}= missing.zero? ? "Every day" : "#{pluralize(missing, "day")} missing"
            = chart_tooltip(label: "#{name}: #{missing} of #{dates.size} days missing") do
              %div{class: "flex gap-px"}
                - dates.each do |date|
                  %span{class: ["h-4 flex-1 rounded-sm hover:ring-2 hover:ring-slate-900 data-active:ring-2 data-active:ring-slate-900", present.include?(date) ? "bg-slate-600" : "bg-amber-200"],
                    data: chart_tip(l(date, format: "%a, %-d %b %Y"), [{value: present.include?(date) ? "Has data" : "Missing", name: name}])}
      %p{class: "border-t border-slate-200 px-4 py-2 text-xs text-slate-500"}
        Search Console fills in the last two or three days late, so they read as missing until the next sync.

    = render layout: "shared/card", locals: {id: "caveats", title: "Known gaps", icon: "info"} do
      - bots = @lifetime_hits[:bots]
      - hits = bots + @lifetime_hits[:humans]
      %ul{class: "list-disc space-y-1.5 py-3 pr-4 pl-8 text-sm text-slate-700"}
        %li
          - if @stats.country_tracking_since
            Views have countries from #{l(@stats.country_tracking_since)}; earlier ones count as Unknown.
          - else
            No views with a country yet.
        %li
          #{pluralize(number_with_delimiter(@stats.undated_likes), "like")} came before likes were dated, so they're in
          no period's figures.
        %li
          Bots made #{number_with_delimiter(bots)} of #{number_with_delimiter(hits)}
          hits#{" (#{number_to_percentage(bots * 100.0 / hits, precision: 1)})" if hits.positive?}, kept out of every
          view count.
        %li
          - if @stats.breakdowns_tracked_since
            Devices and referrers are dated from #{l(@stats.breakdowns_tracked_since)}; earlier ones are only in
            all-time totals.
          - else
            Devices and referrers have no dates yet, so they're all-time totals.
        %li
          - if (since = @stats.visitors_counted_since)
            Unique visitors are counted from #{l(since)}, so a period reaching back further undercounts.
          - else
            Unique visitors aren't counted yet: the blog hasn't kept who it has seen.

%div{class: "mb-6"}
  = render layout: "shared/card", locals: {id: "bots-by-page", title: "Bots by page", icon: "cpu"} do
    - rows = PageView.bot_shares
    %p{class: "border-b border-slate-200 px-4 py-2 text-xs text-slate-500"}
      Pages with #{PageView::MIN_HITS_FOR_BOT_SHARE}+ hits, by the share of them from crawlers, all time since bots aren't dated.
      They're already kept out of every view count; a page high here is one crawlers favour.
    - if rows.empty?
      %p{class: "px-4 py-3 text-sm text-slate-500"} No page has enough hits yet.
    - else
      %div{class: "overflow-x-auto"}
        %table{class: table_class}
          %thead{class: "text-slate-500"}
            %tr
              %th{scope: "col", class: "#{th_class} text-left"} Page
              %th{scope: "col", class: "#{th_class} text-right"} Bot hits
              %th{scope: "col", class: "#{th_class} text-right"} Views
              %th{scope: "col", class: "#{th_class} w-1/3 text-right"} Bot share
          %tbody
            - rows.each do |slug, bots, humans, share|
              %tr{class: "border-t border-slate-200"}
                %td{class: "w-full px-3 py-1.5"}
                  = blog_page_link(slug, page_view_path(slug))
                %td{class: "px-3 py-1.5 text-right tabular-nums"}= number_with_delimiter(bots)
                %td{class: "px-3 py-1.5 text-right tabular-nums"}= number_with_delimiter(humans)
                %td{class: "px-3 py-1.5"}
                  %div{class: "flex items-center gap-3"}
                    %div{class: "flex-1"}= meter(bots, bots + humans, label: "Share of #{slug}'s hits from bots")
                    %span{class: "w-14 shrink-0 text-right tabular-nums"}= number_to_percentage(share * 100, precision: 1)

%div{class: "mb-6 grid items-start gap-6 lg:grid-cols-2"}
  = render layout: "shared/card", locals: {id: "index-waiting", title: "Waiting to be indexed", icon: "clock"} do
    - waiting = @coverage.waiting
    %p{class: "border-b border-slate-200 px-4 py-2 text-xs text-slate-500"}
      Pages from the sitemap Google hasn't indexed, by how long they've waited: since indexing was requested, or else since
      the page last changed.
    - if waiting.empty?
      %p{class: "px-4 py-3 text-sm text-slate-500"} Every crawled page is indexed.
    - else
      %div{class: "border-b border-slate-200 px-4 py-3"}
        = ranking_chart(@coverage.waiting_ages.map { |bucket, count| [bucket, count, "bg-slate-600", ChartsHelper::BAR_COLOR] },
          total: waiting.size, x_title: "Pages", y_title: "Waiting", label: "Pages not indexed, by how long they've waited")
      %div{class: "overflow-x-auto"}
        %table{class: table_class}
          %thead{class: "text-slate-500"}
            %tr
              %th{scope: "col", class: "#{th_class} text-left"} Longest waiting
              %th{scope: "col", class: "#{th_class} text-right"} Days
          %tbody
            - waiting.first(8).each do |row|
              - path = IndexCoverage.path_of(row.page.url)
              %tr{class: "border-t border-slate-200"}
                %td{class: "w-full px-3 py-1.5"}
                  %div{class: "flex items-center gap-1.5"}
                    = blog_page_link(path, crawled_pages_path(q: path, indexed: "no"), live: row.page.url)
                    - if row.requested
                      %span{class: "shrink-0 rounded bg-slate-100 px-1.5 py-0.5 text-xs font-medium text-slate-600"} Requested
                %td{class: "px-3 py-1.5 text-right tabular-nums"}= number_with_delimiter(row.days)

  -# The feed is what's published and the sitemap what Google is offered,
  -# so an entry in one but not the other is either hidden from Google or
  -# an old address still being offered.
  = render layout: "shared/card", locals: {id: "feed-vs-sitemap", title: "Feed against sitemap", icon: "map"} do
    - missing = @coverage.entries_missing_from_sitemap
    - stale = @coverage.sitemap_entries_missing_from_feed
    %div{class: "border-b border-slate-200 px-4 py-3"}
      %p{class: "mb-1 text-xs font-medium text-slate-500"} In the feed, not in the sitemap (#{number_with_delimiter(missing.size)})
      - if missing.empty?
        %p{class: "text-sm text-slate-500"} Every entry is in the sitemap.
      - else
        %ul{class: "space-y-1 text-sm"}
          - missing.first(8).each do |entry|
            %li{class: "flex justify-between gap-3"}
              = blog_page_link(entry.name, feed_entry_path(entry.url), live: entry.url, truncate: true)
              %span{class: "shrink-0 text-slate-500"}= l(entry.published_at.to_date)
    %div{class: "px-4 py-3"}
      %p{class: "mb-1 text-xs font-medium text-slate-500"} Entry pages in the sitemap, not in the feed (#{number_with_delimiter(stale.size)})
      - if stale.empty?
        %p{class: "text-sm text-slate-500"} Every entry page in the sitemap is in the feed.
      - else
        %ul{class: "space-y-1 text-sm"}
          - stale.first(8).each do |page|
            - path = IndexCoverage.path_of(page.url)
            %li{class: "flex justify-between gap-3"}
              = blog_page_link(path, crawled_pages_path(q: path), live: page.url, truncate: true)
              %span{class: "shrink-0 text-slate-500"}= page.indexed ? "Indexed" : "Not indexed"
    %p{class: "border-t border-slate-200 px-4 py-2 text-xs text-slate-500"}
      Matched by path. Only pages under /#{FeedEntry::TYPES.join("/, /")}/ are checked against the feed, since tag and listing
      pages are never in it.

= render "dashboard/freshness", syncs: @syncs
