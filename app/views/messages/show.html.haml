- message = @message
- other_messages = message.other_messages.to_a
- content_for :title, "#{message.name} – Messages"

= link_to messages_path, class: "mb-4 inline-flex items-center gap-1.5 text-sm font-medium text-slate-600 hover:text-slate-900" do
  = icon("arrow-left")
  Messages

%div{class: page_header_class}
  %div
    %h1{class: "text-xl font-semibold tracking-tight break-all"}= message.name
    %p{class: subtitle_class}
      = mail_to message.email, class: "break-all hover:text-slate-900 hover:underline"
      - if message.created_at
        ·
        = time_tag(message.created_at)
  %div{class: "flex flex-col items-end gap-1.5"}
    %div{class: toolbar_class}
      = mail_to message.email, subject: "Re: your message",
        class: "inline-flex items-center gap-1.5 rounded-md bg-slate-900 px-3 py-1.5 text-sm font-medium text-white shadow-sm hover:bg-slate-700" do
        = icon("reply", size: 14)
        Reply

%div{class: "grid gap-6 lg:grid-cols-3"}
  %div{class: "lg:col-span-2"}
    = render layout: "shared/card", locals: {id: "message", title: "Message", icon: "message-square"} do
      %p{class: "px-4 py-3 text-sm whitespace-pre-line break-words text-slate-800"}= message.message
  = render "shared/details", id: "sender", title: "Sender", icon: "users", rows: message_rows(message)

- if other_messages.any?
  %div{class: "mt-6"}
    = render layout: "shared/card", locals: {id: "other-messages", title: "Other messages from #{message.name}", icon: "inbox"} do
      = render "messages/message_list", messages: other_messages
