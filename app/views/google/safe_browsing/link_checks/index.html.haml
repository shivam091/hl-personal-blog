- content_for :title, "Link safety"

%div{class: "mb-6 flex flex-wrap items-start justify-between gap-3"}
  %div
    %h1{class: "text-2xl font-semibold tracking-tight"} Link safety
    %p{class: "mt-1 text-sm text-slate-500"}
      Every link readers have clicked out of the blog, checked against Google Safe Browsing's malware and
      phishing lists.
    = last_sync_status("safe_browsing")
  %div{class: "flex flex-wrap items-center gap-2"}
    = link_to list_url(@filtering, @sorting, format: :csv),
      class: "inline-flex items-center gap-1.5 rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 shadow-sm hover:bg-slate-50" do
      = icon("download", size: 14)
      Export CSV
    = button_to sync_google_safe_browsing_link_checks_path, form_class: "inline-flex",
      class: "inline-flex items-center gap-1.5 rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 shadow-sm hover:bg-slate-50" do
      = icon("refresh", size: 14)
      Check links

- if @flagged_count.positive?
  %div{class: "mb-4 flex gap-3 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800", role: "alert"}
    = icon("alert-triangle", size: 18, class: "text-red-500")
    %p
      #{pluralize(@flagged_count, "link")} readers clicked #{@flagged_count == 1 ? "is" : "are"} listed by Google as unsafe.
      Find where each is linked from and remove or replace it.

= search_panel @filtering, keep: [@sorting, @pagination]
= filter_tabs @filtering, counts: @tab_counts, keep: [@sorting, @pagination]

- if @pagination.total_count.zero?
  = render "shared/empty_state", icon: (@filtering.filtered? ? "search" : "inbox"),
    message: (@filtering.filtered? ? "No links match." : "No links checked yet. Check links to look up every outbound link readers have clicked.")
- else
  %div{class: "relative overflow-x-auto rounded-lg border border-slate-200 bg-white shadow-sm"}
    %table{class: "w-full border-collapse text-left text-sm"}
      %thead{class: "border-b border-slate-200 bg-slate-50 text-slate-600"}
        %tr
          %th{scope: "col", class: "px-3 py-2.5 text-right font-semibold", aria: {label: "Row number"}} #
          - sort_keep = [@filtering, @pagination]
          = sort_header @sorting, "Link", "url", keep: sort_keep, class: "px-3 py-2.5 font-semibold"
          %th{scope: "col", class: "px-3 py-2.5 font-semibold"} Status
          = sort_header @sorting, "Flagged since", "flagged_at", keep: sort_keep, class: "px-3 py-2.5 font-semibold"
          = sort_header @sorting, "Checked", "checked_at", keep: sort_keep, class: "px-3 py-2.5 font-semibold"
      %tbody
        - @checks.each.with_index(@pagination.first_item) do |check, number|
          %tr{class: "border-b border-slate-100 last:border-b-0 hover:bg-slate-50"}
            %td{class: "px-3 py-2 text-right tabular-nums text-slate-500"}= number_with_delimiter(number)
            -# Not a live link: a flagged one shouldn't be a click away.
            %td{class: "max-w-xl px-3 py-2"}
              %span{class: "block truncate font-medium", title: check.url}= check.url
            %td{class: "px-3 py-2 whitespace-nowrap"}
              - if check.flagged?
                %span{class: "rounded-full bg-red-100 px-2 py-0.5 text-xs font-medium text-red-800"}
                  = check.threat_labels.join(", ")
              - else
                %span{class: "rounded-full bg-emerald-100 px-2 py-0.5 text-xs font-medium text-emerald-800"}
                  Safe
            %td{class: "px-3 py-2 whitespace-nowrap text-slate-500"}
              = time_or_dash(check.flagged_at)
            %td{class: "px-3 py-2 whitespace-nowrap text-slate-500"}
              = time_or_dash(check.checked_at)

  = pagination_nav @pagination, keep: [@filtering, @sorting]
