-# Laid out as Search Console's: each figure's tile is its switch and its
-# key, so what's charted and in which colour are read in one place.
- selection = trend.selection
- metrics = metrics.select(&:color)
%section{class: "mb-6 overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm", aria: {label: "Figures over time"}}
  %dl{class: "grid grid-cols-2 sm:grid-cols-4", data: {controller: "trend-metrics"}}
    - metrics.each do |metric|
      -# A tap anywhere on the tile toggles its line, as in Search Console;
      -# the hint is lifted above so it still opens.
      %div{class: "group relative border-t-4 border-(--metric) px-4 py-3 has-checked:bg-(--metric) has-focus-visible:outline-2 has-focus-visible:-outline-offset-2 has-focus-visible:outline-slate-900",
        style: "--metric: #{metric.color}"}
        %dt{class: "flex items-center gap-1.5 text-xs font-medium text-slate-600 group-has-checked:text-white"}
          = check_box_tag "trend[]", metric.field, selection.fields.include?(metric.field), id: "trend-#{metric.field}",
            class: "size-3.5 rounded border-slate-400 accent-white focus-visible:outline-none",
            data: {trend_metrics_target: "box", action: "trend-metrics#change"}
          - tile_label = metric.tile_label || metric.label
          = label_tag "trend-#{metric.field}", tile_label, class: "cursor-pointer after:absolute after:inset-0"
          = render("shared/hint", label: tile_label, text: metric.hint, class: "relative group-has-checked:text-white/80") if metric.hint
        %dd{class: "mt-1 text-2xl font-semibold tabular-nums text-(--metric) group-has-checked:text-white"}= metric_value(totals.value(metric.field), metric.format)
        -# On a white chip, so the change keeps its own colour on any tile.
        - if comparing?
          %dd{class: "mt-1 inline-flex rounded bg-white px-1.5 py-0.5 text-xs", title: "Compared with #{previous_period}"}
            = metric_change(totals.value(metric.field), previous_totals&.value(metric.field), metric)
  %div{class: "border-t border-slate-200 px-4 py-3"}
    -# Hours are stored for a few days only, so there's nothing to group.
    - unless trend.per == "hour"
      %div{class: "mb-2 flex justify-end"}
        = chart_granularity_picker(selection, "the figures", "trend-by")
    - measures = trend_measures(trend, metrics)
    - if measures.any?
      = search_trend_chart(trend, measures, unsettled: unsettled_from)
      - if trend.previous
        %p{class: "mt-2 flex items-center justify-end gap-1.5 text-xs text-slate-500"}
          %span{class: "w-4 border-t-2 border-dotted border-slate-400", aria: {hidden: true}}
          Dotted: #{previous_period}, lined up under these dates
    - else
      %p{class: "py-10 text-center text-sm text-slate-500"} Tick a figure above to chart it.
