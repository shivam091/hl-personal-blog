%div{class: "relative inline-flex", data: {controller: "dropdown", action: "keydown->dropdown#closeWithKeyboard turbo:before-cache@document->dropdown#close"}}
  %button{type: "button", aria: {expanded: "false", controls: "export-menu", haspopup: "true"}, data: {action: "dropdown#toggle", dropdown_target: "button"},
    class: "group inline-flex items-center gap-1.5 rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 shadow-sm hover:bg-slate-50"}
    = icon("download", size: 14)
    Export CSV
    = icon("chevron-down", size: 14, class: "text-slate-400 transition-transform duration-150 group-aria-expanded:rotate-180")
  %ul{id: "export-menu", hidden: true, data: {dropdown_target: "menu"},
    class: "absolute top-full z-10 mt-2 w-72 rounded-lg border border-slate-200 bg-white p-1.5 shadow-lg"}
    - exports.each do |label, url, description|
      %li
        = link_to url, class: "block rounded-md px-3 py-2 text-sm hover:bg-slate-100" do
          %span{class: "block font-medium text-slate-900"}= label
          %span{class: "block text-xs text-slate-500"}= description
