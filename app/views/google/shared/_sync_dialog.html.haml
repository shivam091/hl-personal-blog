-# A dialog so the range is chosen on purpose, since a long one spends API
-# quota and rewrites stored figures. Only Cancel closes it, so a stray
-# Escape or tap on the backdrop doesn't throw away dates being typed.
- label_class = "mb-1 block text-sm font-medium text-slate-700"
- input_class = "block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500"

%div{id: "sync-dialog", class: "inline-flex",
  data: {controller: "modal", modal_open_value: sync_range.errors.any?.to_s, action: "turbo:before-cache@document->modal#close"}}
  %button{type: "button", data: {action: "modal#open"}, aria: {haspopup: "dialog"},
    class: outline_button_class}
    = icon("refresh", size: 14)
    Sync…

  %dialog{data: {modal_target: "dialog", action: "cancel->modal#preventDismiss keydown.esc->modal#preventDismiss"}, aria: {labelledby: "sync-title", describedby: "sync-description"},
    class: "m-auto w-[calc(100%-2rem)] max-w-md overflow-hidden rounded-xl bg-white p-0 text-slate-900 shadow-2xl ring-1 ring-slate-900/5 backdrop:bg-slate-900/60 backdrop:backdrop-blur-sm"}
    = form_with model: sync_range, scope: :google_sync_range, url: url, method: :post, html: {novalidate: true} do |form|
      %div{class: "space-y-5 p-6"}
        %div{class: "flex gap-4"}
          %div{class: "flex size-10 shrink-0 items-center justify-center rounded-full bg-slate-100 text-slate-600"}
            = icon("refresh", size: 18)
          %div
            %h2{id: "sync-title", class: "text-base font-semibold"} Sync from #{source}
            %p{id: "sync-description", class: "mt-1 text-sm text-slate-600"}
              Fetches every day in the range again and updates the stored figures, since Google keeps
              revising recent days. It runs in the background, so the report may take a moment to update.
              - if sync_range.earliest
                #{source} keeps data back to #{l(sync_range.earliest)}.

        - if sync_range.errors.any?
          = render "shared/error_summary", record: sync_range,
            title: "#{pluralize(sync_range.errors.count, "problem")} kept this sync from starting"

        %div{class: "grid gap-4 sm:grid-cols-2"}
          %div
            = form.label :from, class: label_class
            = form.date_field :from, class: input_class, min: sync_range.earliest, max: Date.current
          %div
            = form.label :to, class: label_class
            = form.date_field :to, class: input_class, min: sync_range.earliest, max: Date.current

      %div{class: "flex flex-col-reverse gap-2 border-t border-slate-200 bg-slate-50 px-6 py-4 sm:flex-row sm:justify-end"}
        %button{type: "button", data: {action: "modal#close"},
          class: "inline-flex items-center justify-center gap-1.5 rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 shadow-sm hover:bg-slate-50"}
          = icon("x", size: 14)
          Cancel
        = form.button type: "submit", name: nil,
          class: "inline-flex items-center justify-center gap-1.5 rounded-md bg-slate-900 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-slate-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-600" do
          = icon("refresh", size: 14)
          Start sync
