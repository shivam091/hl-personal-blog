- content_for :title, "Search performance"

= render "google/shared/report", title: "Search performance",
  description: "Clicks and impressions in Google search. Search Console holds the last few days back for two to three days, then revises them.",
  extra: safe_join([render("compare_type"), (render("country_map") if @country_map && @pagination.total_count.positive?),
    (render("breakdown_charts") if @breakdown_charts && @pagination.total_count.positive?)].compact)
