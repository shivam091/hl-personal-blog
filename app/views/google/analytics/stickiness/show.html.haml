- content_for :title, "Analytics stickiness"
- result = @result
- dates = result.days.map(&:date)
- colors = ChartsHelper::SHARE_COLORS
- previous = @previous
-# The period before is trimmed to the days shown so the two share an axis.
- earlier = ->(series, values) { previous ? ChartsHelper::Series.new(name: "#{series.name}, #{@period.previous}", values: values.first(dates.size), dashed: true, color: series.color, against: series) : nil }

%div{class: "mb-6"}
  %h1{class: page_title_class} Analytics stickiness
  %p{class: subtitle_class}
    How many readers each day, week and month, and how many of the month's readers come back on a given day, as GA's
    User activity over time card shows them. Read live from Google Analytics and kept for an hour.

= render "google/shared/period", period: @period, keep: []

- if result.errors.any?
  %div{class: "mb-6 flex gap-3 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800", role: "alert"}
    = icon("alert-circle", size: 18, class: "text-red-500")
    %ul
      - result.errors.each do |error|
        %li= error
- elsif !result.any?
  = render "shared/empty_state", message: "No readers in #{@period}."
- else
  = render "shared/stats", stats: stickiness_stats(result, previous)

  %div{class: "grid items-start gap-6 lg:grid-cols-2"}
    = render layout: "shared/card", locals: {id: "active-readers", title: "Active readers", icon: "users"} do
      %div{class: "px-4 py-3"}
        - active = [["Last 28 days", :monthly], ["Last 7 days", :weekly], ["That day", :daily]].each_with_index.map { |(name, metric), index| ChartsHelper::Series.new(name: name, values: result.days.map(&metric), color: colors[index]) }
        - active += active.zip([:monthly, :weekly, :daily]).filter_map { |now, metric| earlier.(now, previous.days.map(&metric)) if previous }
        = line_chart(dates, active.compact,
          y_title: "Readers", label: "Readers active over the 28 days, 7 days and day to each date")
    = render layout: "shared/card", locals: {id: "stickiness", title: "Coming back", icon: "heart"} do
      %div{class: "px-4 py-3"}
        - shares = stickiness_series(result)
        - shares += shares.zip(previous ? stickiness_series(previous) : []).filter_map { |now, before| earlier.(now, before.values) if before }
        %div{class: "flex flex-col gap-4 sm:flex-row"}
          %div{class: "min-w-0 flex-1"}
            = line_chart(dates, shares, y_title: "Share", unit: "%",
              label: "Share of the longer span's readers who also read in the shorter one, each date")
          %ul{class: "grid shrink-0 grid-cols-3 gap-3 sm:w-28 sm:grid-cols-1 sm:content-center"}
            - stickiness_latest(result, previous).each do |latest|
              %li
                %p{class: "flex items-center gap-1.5 text-xs font-medium text-slate-500"}
                  = marker_svg(latest[:marker], latest[:color], size: 10)
                  = latest[:name]
                %p{class: "text-xl font-semibold text-slate-900"}= latest[:value] || "—"
                %p{class: "text-xs"}= latest[:change]
      %p{class: footnote_class}
        Day / month is the share of the last 30 days' readers who read that day; a blog read now and then sits low, one
        read as a habit higher.
