- content_for :title, "Analytics site search"
- search = @search
- table_class = "w-full border-collapse text-sm"
- th_class = "px-3 py-1.5 font-medium whitespace-nowrap"

%div{class: "mb-6 flex flex-wrap items-start justify-between gap-3"}
  %div
    %h1{class: "text-2xl font-semibold tracking-tight"} Analytics site search
    %p{class: "mt-1 text-sm text-slate-500"}
      What readers type into the blog's search, and what they look for but don't find.
    = last_sync_status("analytics")
  = link_to list_url(@period, format: :csv),
    class: "inline-flex items-center gap-1.5 rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 shadow-sm hover:bg-slate-50" do
    = icon("download", size: 14)
    Export CSV

= render "google/shared/period", period: @period, keep: [], compare: false

= render "shared/period_notes", notes: [counted_from_note(@period.from, Google::Analytics::SiteSearch::COUNTED)]

- if !search.any?
  = render "shared/empty_state",
    message: "No search terms yet. The blog sends them to Analytics as readers search; they arrive with the next Analytics sync."
- else
  %dl{class: "mb-6 grid grid-cols-2 gap-3 lg:grid-cols-4"}
    = render "dashboard/tile", label: "Searches", tile_icon: "search",
      hint: "Every search readers ran on the blog in the period, whether it found anything or not.",
      value: number_with_delimiter(search.searches), change: nil
    = render "dashboard/tile", label: "Terms", tile_icon: "list",
      hint: "Different words or phrases searched for; a term searched many times counts once.",
      value: number_with_delimiter(search.terms.size), change: nil
    = render "dashboard/tile", label: "Found nothing", tile_icon: "alert-circle",
      hint: "The share of searches that showed no results, so readers didn't find what they looked for.",
      value: metric_value(search.not_found_share, :percent), change: nil

  %div{class: "grid items-start gap-6 lg:grid-cols-2"}
    = render layout: "shared/card", locals: {id: "top-terms", title: "Top search terms", icon: "text-search"} do
      - rows = search.top_terms
      - if rows.empty?
        %p{class: "px-4 py-3 text-sm text-slate-500"} No searches in this period.
      - else
        %div{class: "overflow-x-auto"}
          %table{class: table_class}
            %thead{class: "text-slate-500"}
              %tr
                %th{scope: "col", class: "#{th_class} text-left"} Term
                %th{scope: "col", class: "#{th_class} text-right"} Searches
                %th{scope: "col", class: "#{th_class} text-right", title: "Share of this term's searches that found nothing"}
                  Found nothing
            %tbody
              - rows.each do |row|
                %tr{class: "border-t border-slate-200"}
                  %td{class: "px-3 py-1.5 font-medium"}= row.term
                  %td{class: "px-3 py-1.5 text-right tabular-nums"}= number_with_delimiter(row.searches)
                  %td{class: "px-3 py-1.5 text-right tabular-nums #{"text-amber-700" if row.not_found.positive?}"}
                    = metric_value(row.not_found_share, :percent)

    = render layout: "shared/card", locals: {id: "not-found-terms", title: "Searched for but not found", icon: "alert-circle"} do
      %p{class: "border-b border-slate-200 px-4 py-2 text-xs text-slate-500"}
        Terms that found nothing, most searched first: posts worth writing, or words worth adding to existing ones.
      - rows = search.not_found_terms
      - if rows.empty?
        %p{class: "px-4 py-3 text-sm text-slate-500"} Every search found something in this period.
      - else
        %div{class: "overflow-x-auto"}
          %table{class: table_class}
            %thead{class: "text-slate-500"}
              %tr
                %th{scope: "col", class: "#{th_class} text-left"} Term
                %th{scope: "col", class: "#{th_class} text-right", title: "Searches for this term that found nothing"} Found nothing
            %tbody
              - rows.each do |row|
                %tr{class: "border-t border-slate-200"}
                  %td{class: "px-3 py-1.5 font-medium"}= row.term
                  %td{class: "px-3 py-1.5 text-right tabular-nums"}= number_with_delimiter(row.not_found)
