-# New readers at the base, so how many a week brings in reads straight
-# off the axis.
- weeks = @visitor_weeks
= render layout: "shared/card", locals: {id: "new-and-returning", title: "New and returning readers by week", icon: "users", class: "mb-6"} do
  - if weeks[:views].values.flatten.sum.zero?
    %p{class: "px-4 py-3 text-sm text-slate-500"} No views in this period.
  - else
    %div{class: "px-4 py-3"}
      = analytics_visitor_weeks_chart(weeks, @previous_visitor_weeks, @period)
    %p{class: "border-t border-slate-200 px-4 py-2 text-xs text-slate-500"}
      Views rather than readers, since GA's readers can't be added up across days. Every reader in the period, whichever breakdown is open.
