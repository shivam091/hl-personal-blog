- content_for :title, "#{@event_name} – Analytics engagement"
-# Counts are summed into the bucket picked; a ratio can't be, so events per
-# session stays daily.
- over_time = ->(current, previous) { now = ChartsHelper::Series.new(name: @period.to_s, values: current); [now, (ChartsHelper::Series.new(name: @period.previous.to_s, values: previous, dashed: true, against: now) if previous)].compact }
- dates = (@period.from..@period.to).to_a
- buckets = @granularity.dates(dates)
- bucketed = ->(values, period) { values && @granularity.sums_for(period, values) }

= link_to google_analytics_engagement_path(**@period.query), class: "mb-4 inline-flex items-center gap-1.5 text-sm font-medium text-slate-600 hover:text-slate-900" do
  = icon("arrow-left")
  Analytics engagement

%div{class: "mb-6"}
  %h1{class: "#{page_title_class} break-all"}= @event_name
  %p{class: subtitle_class}
    How often the event was triggered and by how many users, where and when, from Google Analytics.

= render "google/shared/period", period: @period, keep: [@granularity]

- if @live_error
  %p{class: "mb-4 flex items-start gap-2 rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900", role: "status"}
    = icon("alert-triangle", size: 16, class: "mt-0.5 shrink-0 text-amber-600")
    %span
      Couldn't get the event's users, sessions and countries from Google Analytics (#{@live_error}), so users are added up from the stored
      days and pages, counting a reader again on each, and the figures only GA has are left out.

= render "google/shared/totals", metrics: Google::Analytics::EventDetailsController::METRICS, totals: @totals,
  previous_totals: @previous_totals, previous_period: @period.previous

= render layout: "shared/card", locals: {id: "event-count-over-time", title: "Event count over time", icon: "activity", class: "mb-6",
  actions: chart_granularity_picker(@granularity, "Event count", "event-count-by")} do
  %div{class: "px-4 py-3"}
    - if @totals.event_count.positive?
      = line_chart(buckets, over_time.(bucketed.(@event_counts, @period), (bucketed.(@previous_event_counts, @period.previous)&.first(buckets.size) if @previous_totals)), y_title: "Event count",
        per: @granularity.per, label: "#{@event_name} events per #{@granularity.by}")
    - else
      %p{class: "py-10 text-center text-sm text-slate-500"} No #{@event_name} events in #{@period}.

%div{class: split_grid_class}
  = render layout: "shared/card", locals: {id: "pages", title: "Event count by page", icon: "file"} do
    %div{class: "px-4 py-3"}
      = render "shared/breakdown", counts: @pages, previous: @previous_pages, heading: "Page path", count_heading: "Events",
        empty: "No #{@event_name} events in #{@period}.", limit: Google::Analytics::EventDetailsController::PAGES_SHOWN
  = render layout: "shared/card", locals: {id: "events-per-session-over-time", title: "Events per session over time", icon: "activity"} do
    %div{class: "px-4 py-3"}
      - if @events_per_session
        = line_chart(dates, over_time.(@events_per_session, @previous_events_per_session), y_title: "Events per session", precision: 2,
          label: "#{@event_name} events per session that had it, per day")
      - else
        %p{class: "py-10 text-center text-sm text-slate-500"} Only Google Analytics can count sessions, and it couldn't be asked.

= render layout: "shared/card", locals: {id: "countries", title: "Event count by country", icon: "globe"} do
  %div{class: "grid items-start gap-6 px-4 py-3 lg:grid-cols-2"}
    - if @countries
      = world_map(@countries, label: "#{@event_name} events by country", unit: "event")
      = render "shared/breakdown", counts: @countries.transform_keys { |code| country_label(code) },
        previous: @previous_countries&.transform_keys { |code| country_label(code) }, heading: "Country", count_heading: "Events",
        empty: "No #{@event_name} events in #{@period}.", limit: Google::Analytics::EventDetailsController::COUNTRIES_SHOWN
    - else
      %p{class: "py-10 text-center text-sm text-slate-500 lg:col-span-2"} Only Google Analytics knows where each event came from, and it couldn't be asked.
