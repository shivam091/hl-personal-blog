- content_for :title, "reCAPTCHA logins"

%div{class: "mb-6 flex flex-wrap items-start justify-between gap-3"}
  %div
    %h1{class: "text-2xl font-semibold tracking-tight"} reCAPTCHA logins
    %p{class: "mt-1 text-sm text-slate-500"} Every admin sign-in attempt reCAPTCHA checked, and why it was let through or turned away.
  = link_to list_url(@filtering, @sorting, format: :csv),
    class: "inline-flex items-center gap-1.5 rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 shadow-sm hover:bg-slate-50" do
    = icon("download", size: 14)
    Export CSV

= search_panel @filtering, keep: [@sorting, @pagination]
= filter_tabs @filtering, counts: @tab_counts, keep: [@sorting, @pagination]

= render "report", report: @report if @report.any?

- if @pagination.total_count.zero?
  = render "shared/empty_state", icon: (@filtering.filtered? ? "search" : "inbox"),
    message: (@filtering.filtered? ? "No sign-in checks match." : "No sign-in checks yet. They're recorded as the admin login is used.")
- else
  %div{class: "relative overflow-x-auto rounded-lg border border-slate-200 bg-white shadow-sm"}
    %table{class: "w-full border-collapse text-left text-sm"}
      %thead{class: "border-b border-slate-200 bg-slate-50 text-slate-600"}
        %tr
          %th{scope: "col", class: "px-3 py-2.5 text-right font-semibold", aria: {label: "Row number"}} #
          - sort_keep = [@filtering, @pagination]
          = sort_header @sorting, "Time", "created_at", keep: sort_keep, class: "px-3 py-2.5 font-semibold"
          = sort_header @sorting, "Action", "action", keep: sort_keep, class: "px-3 py-2.5 font-semibold"
          = sort_header @sorting, "Score", "score", keep: sort_keep, class: "px-3 py-2.5 font-semibold"
          %th{scope: "col", class: "px-3 py-2.5 font-semibold"} Outcome
          %th{scope: "col", class: "px-3 py-2.5 font-semibold"} Password
          %th{scope: "col", class: "px-3 py-2.5 font-semibold"} Client
      %tbody
        - @assessments.each.with_index(@pagination.first_item) do |assessment, number|
          %tr{class: "border-b border-slate-100 last:border-b-0 hover:bg-slate-50"}
            %td{class: "px-3 py-2 text-right tabular-nums text-slate-500"}= number_with_delimiter(number)
            %td{class: "px-3 py-2 whitespace-nowrap"}
              = link_to google_recaptcha_assessment_path(assessment), class: "font-medium text-slate-900 hover:underline" do
                = time_or_dash(assessment.created_at)
            %td{class: "px-3 py-2 text-slate-600"}= assessment.action.presence || "—"
            %td{class: "px-3 py-2"}= recaptcha_score_badge(assessment.score)
            %td{class: "px-3 py-2"}
              = assessment_outcome_badge(assessment)
              - if (reason = assessment.invalid_reason.presence || assessment.reasons.first)
                %p{class: "mt-0.5 text-xs text-slate-500"}= humanize_state(reason)
            %td{class: "px-3 py-2 whitespace-nowrap text-slate-600"}= assessment.password_outcome ? humanize_state(assessment.password_outcome) : "—"
            %td{class: "px-3 py-2"}
              %div{class: "font-mono text-xs text-slate-700"}= assessment.remote_ip
              %div{class: "max-w-56 truncate text-xs text-slate-500", title: assessment.user_agent}= assessment.user_agent

= pagination_nav @pagination, keep: [@filtering, @sorting]
