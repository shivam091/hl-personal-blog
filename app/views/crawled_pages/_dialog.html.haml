-# A modal over the list, so the admin keeps their place (search, sort, page)
-# instead of leaving the list and finding it again. Only its buttons close
-# it, so a stray Escape or tap doesn't lose what's been typed. Saving
-# targets the whole page so the list behind refreshes with the change.
- adding = crawled_page.new_record?

%div{data: {controller: "modal", modal_open_value: "true", action: "turbo:before-cache@document->modal#beforeCache"}}
  %dialog{data: {modal_target: "dialog", action: "cancel->modal#preventDismiss keydown.esc->modal#preventDismiss"},
    aria: {labelledby: "crawled-page-dialog-title", describedby: "crawled-page-dialog-description"},
    class: "m-auto w-[calc(100%-2rem)] max-w-lg overflow-hidden rounded-xl bg-white p-0 text-slate-900 shadow-2xl ring-1 ring-slate-900/5 backdrop:bg-slate-900/60 backdrop:backdrop-blur-sm"}
    = form_with model: crawled_page, html: {novalidate: true}, data: {turbo_frame: "_top"} do |form|
      %div{class: "space-y-5 p-6"}
        %div{class: "flex gap-4"}
          %div{class: "flex size-10 shrink-0 items-center justify-center rounded-full bg-slate-100 text-slate-600"}
            = icon(adding ? "plus" : "pencil", size: 18)
          %div{class: "min-w-0"}
            %h2{id: "crawled-page-dialog-title", class: "text-base font-semibold"}
              = adding ? "New crawled page" : "Edit crawled page"
            %p{id: "crawled-page-dialog-description", class: "mt-1 text-sm break-all text-slate-600"}
              - if adding
                Track a page and whether Google has it indexed.
              - else
                -# The saved URL, so the heading still names the page while
                -# the URL field is being changed.
                = crawled_page.url_was.presence || crawled_page.url

        = render "fields", form: form, crawled_page: crawled_page

      %div{class: "flex flex-col-reverse gap-2 border-t border-slate-200 bg-slate-50 px-6 py-4 sm:flex-row sm:justify-end"}
        -# A link, so Cancel also works when the page is opened on its own.
        = link_to crawled_pages_path, data: {action: "modal#dismiss"},
          class: "inline-flex items-center justify-center gap-1.5 rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 shadow-sm hover:bg-slate-50" do
          = icon("x", size: 14)
          Cancel
        = form.button type: "submit", name: nil,
          class: "inline-flex items-center justify-center gap-1.5 rounded-md bg-slate-900 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-slate-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900" do
          = icon(adding ? "plus" : "save", size: 14)
          = adding ? "Add page" : "Save changes"
