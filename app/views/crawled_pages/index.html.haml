- content_for :title, "Crawled pages"

%div{class: "mb-6 flex flex-wrap items-start justify-between gap-3"}
  %div
    %h1{class: "text-2xl font-semibold tracking-tight"} Crawled pages
    = last_sync_status("sitemap")
  %div{class: "flex flex-wrap items-center gap-2"}
    = link_to list_url(@filtering, @sorting, format: :csv), class: "inline-flex items-center gap-1.5 rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 shadow-sm hover:bg-slate-50" do
      = icon("download", size: 14)
      Export CSV
    = button_to sync_crawled_pages_path, form_class: "inline-flex", title: "Also runs daily at 00:00 UTC",
      class: "inline-flex items-center gap-1.5 rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 shadow-sm hover:bg-slate-50" do
      = icon("refresh", size: 14)
      Sync sitemap
    = link_to new_crawled_page_path, data: {turbo_frame: "modal"},
      class: "inline-flex items-center gap-1.5 rounded-md bg-slate-900 px-3 py-1.5 text-sm font-medium text-white shadow-sm hover:bg-slate-700" do
      = icon("plus", size: 14)
      New page

= form_with url: import_crawled_pages_path, multipart: true,
  class: "mb-6 flex flex-wrap items-center gap-3 rounded-lg border border-slate-200 bg-white px-4 py-3 shadow-sm" do |form|
  = form.label :file, "Import CSV", class: "text-sm font-medium text-slate-700"
  = form.file_field :file, accept: ".csv,text/csv",
    class: "text-sm text-slate-600 file:mr-3 file:rounded-md file:border-0 file:bg-slate-100 file:px-3 file:py-1.5 file:text-sm file:font-medium file:text-slate-700 hover:file:bg-slate-200"
  = form.button type: "submit", name: nil,
    class: "inline-flex items-center gap-1.5 rounded-md bg-slate-900 px-3 py-1.5 text-sm font-medium text-white shadow-sm hover:bg-slate-700" do
    = icon("upload", size: 14)
    Import
  %p{class: "w-full text-xs text-slate-500"}
    Columns: #, URL, Last modified, Status ("Yes" = indexed). Matches on URL: new URLs are added, and existing ones get their last modified and status updated.

= search_panel @filtering, keep: [@sorting, @pagination]
= filter_tabs @filtering, counts: @tab_counts, keep: [@sorting, @pagination]

- if @pagination.total_count.zero?
  = render "shared/empty_state", icon: (@filtering.filtered? ? "search" : "inbox"),
    message: (@filtering.filtered? ? "No crawled pages match." : "No crawled pages yet. Import a CSV, sync the sitemap, or add one.")
- else
  -# The row checkboxes join this form through their form attribute, since
  -# each row's own buttons are forms and forms can't nest.
  %div{data: {controller: "bulk-select", bulk_select_one_value: "page", bulk_select_many_value: "pages"}}
    = form_with url: mark_indexed_crawled_pages_path, method: :patch, id: "bulk-mark-indexed",
      class: "mb-3 flex items-center justify-between gap-3", data: {bulk_select_target: "form"} do
      %p{class: "text-sm text-slate-600", aria: {live: "polite"}, data: {bulk_select_target: "count"}} No pages selected
      - button_class = "inline-flex items-center gap-1.5 rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium shadow-sm disabled:cursor-not-allowed disabled:opacity-50 disabled:hover:border-slate-300 disabled:hover:bg-white"
      %div{class: "flex flex-wrap items-center justify-end gap-2"}
        %button{type: "submit", disabled: true, data: {bulk_select_target: "submit"},
          class: "#{button_class} text-emerald-700 hover:border-emerald-300 hover:bg-emerald-50"}
          = icon("check-circle", size: 14)
          Mark as indexed
        %button{type: "submit", disabled: true, formaction: mark_not_indexed_crawled_pages_path, data: {bulk_select_target: "submit"},
          class: "#{button_class} text-slate-700 hover:bg-slate-50"}
          = icon("rotate-ccw", size: 14)
          Mark as not indexed
        %button{type: "submit", disabled: true, formaction: request_indexing_crawled_pages_path, data: {bulk_select_target: "submit"},
          class: "#{button_class} text-slate-700 hover:bg-slate-50"}
          = icon("clock", size: 14)
          Mark as requested

    %div{class: "relative overflow-x-auto rounded-lg border border-slate-200 bg-white shadow-sm"}
      %table{class: "w-full border-collapse text-left text-sm"}
        %thead{class: "border-b border-slate-200 bg-slate-50 text-slate-600"}
          %tr
            %th{scope: "col", class: "w-0 py-2.5 pr-1 pl-3"}
              %input{type: "checkbox", class: "block size-4 rounded border-slate-300 accent-slate-900",
                aria: {label: "Select every page listed here"},
                data: {bulk_select_target: "all", action: "bulk-select#toggleAll"}}
            %th{scope: "col", class: "px-3 py-2.5 text-right font-semibold", aria: {label: "Row number"}} #
            - sort_keep = [@filtering, @pagination]
            = sort_header @sorting, "URL", "url", keep: sort_keep, class: "px-3 py-2.5 font-semibold"
            = sort_header @sorting, "Last modified", "last_modified_at", keep: sort_keep, class: "px-3 py-2.5 font-semibold"
            = sort_header @sorting, "Indexed", "indexed", keep: sort_keep, class: "px-3 py-2.5 font-semibold"
            %th{scope: "col", class: "px-3 py-2.5"}
              %span{class: "sr-only"} Actions
        %tbody
          - @crawled_pages.each.with_index(@pagination.first_item) do |page, number|
            %tr{class: "border-b border-slate-100 last:border-b-0 hover:bg-slate-50 has-checked:bg-slate-100"}
              %td{class: "py-2 pr-1 pl-3"}
                %input{type: "checkbox", name: "ids[]", value: page.id, form: "bulk-mark-indexed",
                  class: "block size-4 rounded border-slate-300 accent-slate-900",
                  aria: {label: "Select #{page}"},
                  data: {bulk_select_target: "item", action: "bulk-select#update"}}
              %td{class: "px-3 py-2 text-right tabular-nums text-slate-500"}= number_with_delimiter(number)
              %td{class: "px-3 py-2 whitespace-nowrap"}
                = blog_page_link(page.url, nil)
              %td{class: "px-3 py-2 whitespace-nowrap text-slate-500"}
                - if page.last_modified_at
                  %time{datetime: page.last_modified_at.iso8601}= l(page.last_modified_at)
                - else
                  —
              %td{class: "px-3 py-2"}
                - if page.indexed
                  %span{class: "inline-flex size-6 items-center justify-center rounded-full bg-emerald-100 text-emerald-700"}
                    = icon("check", size: 14, label: "Indexed")
                - elsif page.index_requested_at
                  %span{class: "inline-flex items-center gap-1 rounded-full bg-amber-100 px-2 py-0.5 text-xs font-medium text-amber-800",
                    title: "Requested in Search Console #{l(page.index_requested_at)}; marked indexed once an inspection finds it in Google"}
                    = icon("clock", size: 12)
                    Requested
                - else
                  %span{class: "inline-flex size-6 items-center justify-center rounded-full bg-slate-100 text-slate-400"}
                    = icon("x", size: 14, label: "Not indexed")
              %td{class: "px-3 py-2 text-right whitespace-nowrap"}
                = copy_button(page.url, "Copy URL to clipboard")
                -# Spends one of the day's inspections, so it's asked for rather
                -# than run on every visit.
                = button_to inspect_url_crawled_page_path(page), form_class: "inline-flex", title: "Inspect URL now",
                  class: "inline-flex rounded-md p-1.5 text-slate-500 hover:bg-slate-100 hover:text-slate-900",
                  aria: {label: "Inspect #{page} now"} do
                  = icon("file-search")
                - unless page.indexed
                  = button_to request_indexing_crawled_page_path(page), method: :patch, form_class: "inline-flex",
                    title: (page.index_requested_at ? "Mark as requested again" : "Mark as requested"),
                    class: "inline-flex rounded-md p-1.5 text-slate-500 hover:bg-slate-100 hover:text-slate-900",
                    aria: {label: "Mark #{page} as requested"} do
                    = icon("clock")
                - if page.indexed
                  = button_to mark_not_indexed_crawled_page_path(page), method: :patch, title: "Mark as not indexed", form_class: "inline-flex",
                    class: "inline-flex rounded-md p-1.5 text-slate-500 hover:bg-slate-100 hover:text-slate-900",
                    aria: {label: "Mark #{page} as not indexed"} do
                    = icon("rotate-ccw")
                - else
                  = button_to mark_indexed_crawled_page_path(page), method: :patch, title: "Mark as indexed", form_class: "inline-flex",
                    class: "inline-flex rounded-md p-1.5 text-emerald-600 hover:bg-emerald-50 hover:text-emerald-700",
                    aria: {label: "Mark #{page} as indexed"} do
                    = icon("check-circle")
                = link_to edit_crawled_page_path(page), title: "Edit", data: {turbo_frame: "modal"},
                  class: "inline-flex rounded-md p-1.5 text-slate-500 hover:bg-slate-100 hover:text-slate-900",
                  aria: {label: "Edit #{page}"} do
                  = icon("pencil")

= pagination_nav @pagination, keep: [@filtering, @sorting]

-# Empty until a dialog opens, so the list stays put behind it.
= turbo_frame_tag "modal"
