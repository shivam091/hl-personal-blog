- content_for :title, "Country report"

%div{class: "mb-6 flex flex-wrap items-start justify-between gap-3"}
  %div
    %h1{class: "text-2xl font-semibold tracking-tight"} Country report
    %p{class: "mt-1 text-sm text-slate-500"}
      Views, likes, subscribers and messages per country, and the rates between them.
  = link_to list_url(@period, @filtering, @sorting, format: :csv),
    class: "inline-flex items-center gap-1.5 rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 shadow-sm hover:bg-slate-50" do
    = icon("download", size: 14)
    Export CSV

= render "shared/stats_filters", stats: @stats, period: @period, filtering: @filtering, keep: [@sorting]

%div{class: "mb-6 grid items-start gap-6 lg:grid-cols-2"}
  = render layout: "shared/card", locals: {id: "views-map", title: "Views by country", icon: "globe"} do
    %div{class: "px-4 py-3"}
      = world_map(@stats.by_country(:views), label: "Views by country", unit: "view")
  = render "shared/country_shares", stats: @stats

- if @rows.empty?
  = render "shared/empty_state", message: "Nothing recorded in #{@period}."
- else
  %div{id: "country-table", class: "overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm"}
    = render "country_reports/table", rows: @rows, sorting: @sorting, extras: @extras
  %p{class: "mt-2 text-xs text-slate-500"}
    Rates show for countries with #{BlogStats::MIN_VIEWS_FOR_RATE}+ views. Visitors aren't kept long enough to
    count per period, so rates are per view.
