-# The cell carries a plain colour under the gradient, so clients that drop
-# gradients, like Outlook, still show a solid button.
%table{role: "presentation", cellpadding: 0, cellspacing: 0, style: "margin:28px auto 8px;"}
  %tr
    %td{style: "border-radius:12px;background:#4f46e5;background-image:linear-gradient(135deg,#4f46e5 0%,#7c3aed 100%);box-shadow:0 8px 20px rgba(79,70,229,0.28);"}
      %a{href: url, style: "display:inline-block;padding:15px 32px;color:#ffffff;font-size:16px;font-weight:700;text-decoration:none;border-radius:12px;"}
        = label
