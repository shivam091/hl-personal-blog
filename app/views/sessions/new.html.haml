- content_for :title, "Sign in"

%div{class: "mx-auto mt-8 max-w-sm sm:mt-16"}
  %h1{class: "mb-6 text-center text-2xl font-semibold tracking-tight"} Sign in

  = form_with url: session_path, class: "space-y-5 rounded-lg border border-slate-200 bg-white p-6 shadow-sm" do |form|
    %div
      = form.label :username, "Username", class: "mb-1.5 block text-sm font-medium text-slate-700"
      = form.text_field :username, value: params[:username], autofocus: true,
        autocomplete: "username", autocapitalize: "none", spellcheck: false,
        class: "h-10 w-full rounded-md border border-slate-300 px-3 text-sm shadow-sm focus:border-slate-500 focus:ring-1 focus:ring-slate-500 focus:outline-none"
    %div
      = form.label :password, "Password", class: "mb-1.5 block text-sm font-medium text-slate-700"
      = form.password_field :password, autocomplete: "current-password",
        class: "h-10 w-full rounded-md border border-slate-300 px-3 text-sm shadow-sm focus:border-slate-500 focus:ring-1 focus:ring-slate-500 focus:outline-none"
    = form.button type: "submit", name: nil,
      class: "inline-flex h-10 w-full items-center justify-center gap-2 rounded-md bg-slate-900 text-sm font-medium text-white shadow-sm hover:bg-slate-700" do
      = icon("log-in")
      Sign in

  %p{class: "mt-6 rounded-md border border-amber-200 bg-amber-50 px-4 py-3 text-xs leading-relaxed text-amber-900", role: "note"}
    = t(".notice")
