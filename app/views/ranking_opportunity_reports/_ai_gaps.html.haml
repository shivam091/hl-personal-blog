-# Over the latest upload's days, whatever period is picked, since that's
-# all Google's page totals for AI answers cover.
- if gaps.any?
  - range = "#{l(gaps.period.from)} – #{l(gaps.period.to)}"
  - lists = [["ai-shown-not-clicked", "Shown in AI answers, seldom clicked", "sparkles", gaps.shown_not_clicked,
    "Pages with #{Google::SearchConsole::AiGaps::MIN_AI_IMPRESSIONS}+ AI impressions in #{range}, fewest search clicks per AI impression first. The answer may be all a reader needs, so these are the pages worth giving a reason to click.",
    "No page was shown in AI answers often enough to judge."],
    ["ai-missing", "In search, missing from AI answers", "eye-off", gaps.missing_from_ai,
    "Pages search showed #{Google::SearchConsole::Summary::MIN_IMPRESSIONS}+ times in #{range} that no AI answer did, most shown first.",
    "Every page search showed often was in an AI answer too."]]
  %div{class: "mt-6 grid items-start gap-6 lg:grid-cols-2"}
    - lists.each do |id, title, card_icon, rows, note, empty|
      = render layout: "shared/card", locals: {id: id, title: title, icon: card_icon} do
        %p{class: lead_note_class}
          = note
          Every country, from the latest Generative AI upload (#{gaps.ai.search_type}).
        - if rows.empty?
          %p{class: empty_note_class}= empty
        - else
          = report_table([report_th("Page"),
            report_th("AI impressions", :right),
            report_th("Search impressions", :right),
            report_th("Clicks", :right)]) do
            - rows.each do |row|
              %tr{class: table_row_class}
                %td{class: title_cell_class}= blog_page_link(row.page_path, page_view_path(row.page_path))
                %td{class: cell_class}= number_with_delimiter(row.ai_impressions)
                %td{class: cell_class}= number_with_delimiter(row.impressions)
                %td{class: cell_class}= number_with_delimiter(row.clicks)
