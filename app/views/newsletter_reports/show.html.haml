- content_for :title, "Newsletter report"
- newsletter = @newsletter
- table_class = "w-full border-collapse text-sm"
- th_class = "px-3 py-1.5 font-medium whitespace-nowrap"
- window = NewsletterStats::SIGNUP_WINDOW

%div{class: "mb-6"}
  %h1{class: "text-2xl font-semibold tracking-tight"} Newsletter report
  %p{class: "mt-1 text-sm text-slate-500"}
    Whether entries bring readers onto the list, and whether the mail announcing them arrives.

= render "google/shared/period", period: @period, keep: []

- sends = newsletter.sends
- sent = sends.sum(&:sent)
- undelivered = newsletter.undelivered
%dl{class: "mb-6 grid grid-cols-2 gap-3 lg:grid-cols-4"}
  = render "dashboard/tile", label: "List size", tile_icon: "users", value: number_with_delimiter(newsletter.list_size), change: nil,
    hint: "Everyone subscribed now. Leaving deletes a subscriber, so the list's past size can't be rebuilt."
  = render "dashboard/tile", label: "New subscribers", tile_icon: "plus", value: number_with_delimiter(newsletter.new_subscribers),
    change: (metric_change(newsletter.new_subscribers, newsletter.new_subscribers(@period.previous), DashboardHelper::HIGHER_IS_BETTER) unless @period.compare_countries?),
    compared_with: @period.previous, hint: "Sign-ups in the period."
  = render "dashboard/tile", label: "Emails sent", tile_icon: "send", value: number_with_delimiter(sent), change: "Last #{NewsletterStats::SEND_MONTHS} months",
    hint: "New-entry emails that went out, by the month each entry was sent."
  = render "dashboard/tile", label: "Undelivered", tile_icon: "alert-triangle", value: number_with_delimiter(undelivered),
    change: ("#{number_to_percentage(undelivered * 100.0 / (sent + undelivered), precision: 1)} of tries" if (sent + undelivered).positive?),
    hint: "Emails still failed, waiting to be sent again from Feed entries. A resend that gets through takes them off."

%div{class: "mb-6"}
  -# Both weeks per entry side by side, so an entry that brought readers in
  -# stands out from one that only came out in a busy week.
  = render layout: "shared/card", locals: {id: "signups-around-entries", title: "Sign-ups around each entry", icon: "users"} do
    - rows = newsletter.signups_around_entries
    %p{class: "border-b border-slate-200 px-4 py-2 text-xs text-slate-500"}
      Sign-ups in the #{window} days before each entry came out against the #{window} days from its publishing day, for entries
      published in the period. A later entry within the same week counts in both.
    - if rows.empty?
      %p{class: "px-4 py-3 text-sm text-slate-500"} Nothing published in #{@period}.
    - else
      %div{class: "overflow-x-auto"}
        %table{class: table_class}
          %thead{class: "text-slate-500"}
            %tr
              %th{scope: "col", class: "#{th_class} text-left"} Entry
              %th{scope: "col", class: "#{th_class} text-right"} Published
              %th{scope: "col", class: "#{th_class} text-right"} Week before
              %th{scope: "col", class: "#{th_class} text-right"} Week after
              %th{scope: "col", class: "#{th_class} text-right"} Change
          %tbody
            - rows.each do |row|
              %tr{class: "border-t border-slate-200"}
                %td{class: "w-full px-3 py-1.5"}
                  = blog_page_link(row.entry.name, feed_entry_path(row.entry.url), live: row.entry.url)
                %td{class: "px-3 py-1.5 text-right whitespace-nowrap text-slate-500"}= l(row.entry.published_at.to_date)
                %td{class: "px-3 py-1.5 text-right tabular-nums"}= number_with_delimiter(row.before)
                %td{class: "px-3 py-1.5 text-right tabular-nums"}
                  = number_with_delimiter(row.after)
                  - unless row.complete
                    %span{class: "ml-1 rounded bg-slate-100 px-1.5 py-0.5 text-xs font-medium text-slate-600", title: "The week after isn't over yet"} So far
                %td{class: ["px-3 py-1.5 text-right tabular-nums", ("text-emerald-700" if row.change.positive?), ("text-red-700" if row.change.negative?)]}
                  = row.change.positive? ? "+#{row.change}" : row.change

%div{class: "mb-6 grid items-start gap-6 lg:grid-cols-2"}
  = render layout: "shared/card", locals: {id: "sends-by-month", title: "Emails by month", icon: "send"} do
    %div{class: "px-4 py-3"}
      - if sends.all? { |month| (month.sent + month.undelivered).zero? }
        %p{class: "text-sm text-slate-500"} No new-entry emails sent in the last #{NewsletterStats::SEND_MONTHS} months.
      - else
        = stacked_chart(sends.map(&:month), [ChartsHelper::Series.new(name: "Delivered", values: sends.map(&:sent), color: ChartsHelper::SHARE_COLORS[2]),
          ChartsHelper::Series.new(name: "Undelivered", values: sends.map(&:undelivered), color: ChartsHelper::SHARE_COLORS[1])],
          y_title: "Emails", label: "New-entry emails per month, delivered and still undelivered", per: :month)

  = render layout: "shared/card", locals: {id: "failure-reasons", title: "Why emails failed", icon: "alert-circle"} do
    %div{class: "px-4 py-3"}
      = render "shared/breakdown", counts: newsletter.failure_reasons, heading: "Error", count_heading: "Emails",
        empty: "No undelivered emails waiting."
    %p{class: "border-t border-slate-200 px-4 py-2 text-xs text-slate-500"}
      By the error's kind; each address and its full error are on its entry in Feed entries.
