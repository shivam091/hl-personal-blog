-# Where readers join from beside how soon they leave, so a form that grows
-# the list is told from one that only fills it for a week.
- lower_is_better = DashboardHelper::Kpi.new(lower_is_better: true)
- since = audience.counted_since
- left = audience.unsubscribe_count
- rate = audience.churn_rate
- median = audience.median_days_subscribed
- previous = period.previous unless period.compare_countries?

- if since.nil? || period.from < since
  %div{class: "mb-4 flex gap-3 rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900", role: "note"}
    = icon("info", size: 18, class: "text-amber-600")
    %p
      - if since
        Unsubscribes are recorded from #{l(since)}, so earlier days in this period have none, and the churn rate needs a period
        starting then or later.
      - else
        No unsubscribes recorded yet; the blog keeps one for each reader who leaves from now on.

%dl{class: "mb-6 grid grid-cols-2 gap-3 lg:grid-cols-3"}
  = render "dashboard/tile", label: "Unsubscribes", tile_icon: "log-out", value: number_with_delimiter(left),
    change: (metric_change(left, audience.unsubscribe_count(previous), lower_is_better) if previous && audience.counted?(previous)),
    compared_with: previous, hint: "Readers who left in the period, by the unsubscribe link or their mail app's button."
  = render "dashboard/tile", label: "Churn rate", tile_icon: "trending-up", value: (rate ? number_to_percentage(rate * 100, precision: 1) : "—"),
    change: (metric_change(rate, audience.churn_rate(previous), lower_is_better) if rate && previous),
    compared_with: previous, hint: "Unsubscribes in the period as a share of everyone on the list as it began."
  = render "dashboard/tile", label: "Typical stay", tile_icon: "clock", value: (median ? pluralize(median, "day") : "—"), change: nil,
    hint: "The median time on the list of the readers who left in the period."

%div{class: "mb-6 grid items-start gap-6 lg:grid-cols-2"}
  = render layout: "shared/card", locals: {id: "signups-by-source", title: "Sign-ups by form", icon: "users"} do
    %div{class: "px-4 py-3"}
      = donut_chart(audience.signups_by_source, label: "Sign-ups by form", unit: "sign-up", empty: "No sign-ups in this period.")
    %p{class: "border-t border-slate-200 px-4 py-2 text-xs text-slate-500"}
      Sign-ups in the period, those who've left since included. Unknown ones came before the blog recorded the form.

  = render layout: "shared/card", locals: {id: "signups-by-page", title: "Sign-ups by page", icon: "file"} do
    %div{class: "px-4 py-3"}
      = render "shared/breakdown", counts: audience.signups_by_page, heading: "Page", count_heading: "Sign-ups",
        empty: "No sign-ups in this period."
    %p{class: "border-t border-slate-200 px-4 py-2 text-xs text-slate-500"}
      The page the form was on, top #{NewsletterAudience::PAGES}.

%div{class: "mb-6 grid items-start gap-6 lg:grid-cols-3"}
  = render layout: "shared/card", locals: {id: "unsubscribes-by-week", title: "Unsubscribes by week", icon: "log-out"} do
    %div{class: "px-4 py-3"}
      - weeks = audience.weekly_unsubscribes
      - if weeks.sum(&:last).zero?
        %p{class: "text-sm text-slate-500"} Nobody left in this period.
      - else
        = time_chart(weeks, y_title: "Unsubscribes", label: "Readers who left the list each week", per: :week)

  = render layout: "shared/card", locals: {id: "unsubscribe-methods", title: "How they left", icon: "mouse-pointer"} do
    %div{class: "px-4 py-3"}
      = donut_chart(audience.by_method, label: "Readers who left by how they left", unit: "reader", empty: "Nobody left in this period.")

  = render layout: "shared/card", locals: {id: "time-to-unsubscribe", title: "Time on the list before leaving", icon: "timer"} do
    - stays = audience.stays
    %div{class: "px-4 py-3"}
      - if stays.values.sum.zero?
        %p{class: "text-sm text-slate-500"} Nobody left in this period.
      - else
        = ranking_chart(stays.reject { |band, count| band == NewsletterAudience::UNKNOWN_STAY && count.zero? }.map { |band, count| [band, count, "bg-slate-600", ChartsHelper::BAR_COLOR] },
          total: stays.values.sum, x_title: "Readers", y_title: "Stayed", label: "Readers who left in the period by how long they'd been subscribed")
