- content_for :preheader, "Syncs from #{l(@digest.from, format: :short)} to #{l(@digest.to, format: :short)}: #{@digest.summary}."
- content_for :hero, @digest.healthy? ? "✅ Every sync went through" : "⚠️ Some syncs need a look"

%h1.mail-h1{style: "margin:0 0 14px;font-size:26px;line-height:1.3;font-weight:800;letter-spacing:-0.4px;color:#0f172a;"}
  Sync digest
%p{style: "margin:0 0 24px;font-size:16px;line-height:1.65;color:#334155;"}
  From #{l(@digest.from, format: :short)} to #{l(@digest.to, format: :short)}: #{@digest.summary}.

- if @digest.counts.any?
  %p{style: "margin:0 0 28px;font-size:14px;line-height:1.65;color:#64748b;"}
    = @digest.counts.map { |status, count| "#{count} #{sync_status_label(status).downcase}" }.join(" · ")

- if @digest.problems.any? || @digest.missing_snapshot
  %h2{style: "margin:0 0 12px;font-size:18px;font-weight:700;color:#0f172a;"} Needs a look
  - if @digest.missing_snapshot
    %table{role: "presentation", width: "100%", cellpadding: 0, cellspacing: 0, style: "margin:0 0 12px;border:1px solid #e2e8f0;border-radius:12px;border-collapse:separate;"}
      %tr
        %td{style: "padding:14px 16px;"}
          %p{style: "margin:0;font-size:15px;font-weight:700;color:#0f172a;"}
            Consent snapshots
            %span{style: "font-weight:600;color:#b91c1c;"} · Missing
          %p{style: "margin:4px 0 0;font-size:13px;line-height:1.5;color:#334155;"}
            None was stored for #{l(@digest.missing_snapshot)}, so the consent flags can't judge that day. Run bin/rails consent:snapshot.
  - @digest.problems.each do |request|
    %table{role: "presentation", width: "100%", cellpadding: 0, cellspacing: 0, style: "margin:0 0 12px;border:1px solid #e2e8f0;border-radius:12px;border-collapse:separate;"}
      %tr
        %td{style: "padding:14px 16px;"}
          %p{style: "margin:0;font-size:15px;font-weight:700;color:#0f172a;"}
            = request.section
            %span{style: "font-weight:600;color:#{request.display_status == "partial" ? "#b45309" : "#b91c1c"};"} · #{sync_status_label(request.display_status)}
          %p{style: "margin:4px 0 0;font-size:13px;color:#64748b;"}
            #{request.source} · #{request.trigger_label} · started #{l(request.created_at, format: :short)}
          - request.error_messages.first(SyncDigest::ERRORS_SHOWN).each do |error|
            %p{style: "margin:8px 0 0;font-size:13px;line-height:1.5;color:#334155;"}= error
          - if (more = request.error_count - SyncDigest::ERRORS_SHOWN).positive?
            %p{style: "margin:8px 0 0;font-size:13px;color:#64748b;"} and #{pluralize(more, "more error")}

%h2{style: "margin:28px 0 12px;font-size:18px;font-weight:700;color:#0f172a;"} Last successful sync
%table{role: "presentation", width: "100%", cellpadding: 0, cellspacing: 0, style: "font-size:14px;color:#334155;"}
  - @digest.freshness.each do |kind, (completed, _latest)|
    %tr
      %td{style: "padding:6px 12px 6px 0;border-bottom:1px solid #f1f5f9;"}= SyncRequest::KINDS.fetch(kind).section
      %td{style: "padding:6px 0;border-bottom:1px solid #f1f5f9;text-align:right;white-space:nowrap;color:#{completed ? "#64748b" : "#b91c1c"};"}
        = completed ? "#{time_ago_in_words(completed.finished_at)} ago" : "Never"
