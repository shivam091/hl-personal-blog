-# Shares are of the clicks across every group, so a group's weight reads
-# beside its own figures.
- clicks = groups.sum(&:clicks)
-# Each group's clicks and impressions against the same group then, when a
-# comparison is picked.
- before = local_assigns[:previous]&.index_by(&:name)
- metrics = google_search_metrics.index_by(&:field)
%div{class: "overflow-x-auto"}
  %table{class: table_class}
    %thead{class: "border-b border-slate-200 bg-slate-50 text-slate-600"}
      %tr
        = report_th heading
        = report_th "Queries", :right
        = report_th "Clicks", :right
        = report_th "Share", :right
        = report_th "Impressions", :right
        = report_th "CTR", :right
        = report_th "Position", :right
    %tbody
      - groups.each do |group|
        %tr{class: "border-t border-slate-100"}
          %td{class: "px-3 py-1.5 font-medium whitespace-nowrap"}= group.name
          %td{class: "px-3 py-1.5 text-right tabular-nums"}= number_with_delimiter(group.queries)
          %td{class: "px-3 py-1.5 text-right tabular-nums"}
            = number_with_delimiter(group.clicks)
            - if before
              %div= row_change(group.clicks, before[group.name]&.clicks, metrics.fetch(:clicks))
          %td{class: "px-3 py-1.5 text-right tabular-nums"}= clicks.positive? ? number_to_percentage(group.clicks * 100.0 / clicks, precision: 1) : "—"
          %td{class: "px-3 py-1.5 text-right tabular-nums"}
            = number_with_delimiter(group.impressions)
            - if before
              %div= row_change(group.impressions, before[group.name]&.impressions, metrics.fetch(:impressions))
          %td{class: "px-3 py-1.5 text-right tabular-nums"}= group.ctr ? metric_value(group.ctr, :percent) : "—"
          %td{class: "px-3 py-1.5 text-right tabular-nums"}= group.position ? metric_value(group.position, :position) : "—"
