-# So it's plain how much of the blog's search visibility now comes
-# through AI answers.
-# Site-wide only, since Google doesn't split AI impressions by country and
-# a share of one country's impressions would mean nothing.
- if ai.any? && !country
  - impressions = search.daily(:impressions)
  - shares = ai.daily.zip(impressions).map { |shown, seen| (shown.to_f / seen * 100).round(1) if shown && seen.to_i.positive? }
  - total = ai.total
  - all = search.totals.value(:impressions).to_i
  -# Needs an upload and a sync from before the compared period, or the share would read as a jump from nothing.
  - earlier_total = ai.previous_total if search.compared?
  - earlier_all = search.previous_totals&.value(:impressions).to_i if earlier_total
  - earlier_share = (earlier_total.to_f / earlier_all * 100 if earlier_total && earlier_all.positive?)
  - earlier = @period.previous
  %div{class: "mb-6"}
    = render layout: "shared/card", locals: {id: "ai-share", title: "Share of impressions from AI answers", icon: "sparkles"} do
      %div{class: "px-4 py-3"}
        - if shares.compact.any?
          = report_ai_share_chart(ai, search, dates, shares, earlier, earlier_share)
        - else
          %p{class: "text-sm text-slate-500"} No AI impressions uploaded for days in #{@period}.
      %p{class: "border-t border-slate-200 px-4 py-2 text-xs text-slate-500"}
        - if total && all.positive?
          #{number_with_delimiter(total)} AI impressions (#{ai.search_type}), #{number_to_percentage(total.to_f / all * 100, precision: 1)} of the period's #{number_with_delimiter(all)} search impressions.
          - if earlier_share
            Against #{number_to_percentage(earlier_share, precision: 1)} in #{earlier} (#{number_with_delimiter(earlier_total)} of #{number_with_delimiter(earlier_all)}):
            = metric_change(total.to_f / all * 100, earlier_share, CompareHelper::MORE_IS_BETTER)
        From uploads of Search Console's Generative AI report; days not uploaded are left blank rather than read as none.
        = link_to "Generative AI performance", google_search_console_generative_ai_path(**@period.query), class: "font-medium text-slate-700 underline hover:text-slate-900"
