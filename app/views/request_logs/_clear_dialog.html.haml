-# A modal so clearing, which can't be undone, takes a deliberate second
-# step with the range spelled out, rather than a button press on the list.
-# Only Cancel closes it: a stray Escape or tap on the backdrop shouldn't
-# throw away dates the admin has entered.
- label_class = "mb-1 block text-sm font-medium text-slate-700"
- input_class = "block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500"

%dialog{data: {modal_target: "dialog", action: "cancel->modal#preventDismiss keydown.esc->modal#preventDismiss"}, aria: {labelledby: "clear-logs-title", describedby: "clear-logs-description"},
  class: "m-auto w-[calc(100%-2rem)] max-w-md overflow-hidden rounded-xl bg-white p-0 text-slate-900 shadow-2xl ring-1 ring-slate-900/5 backdrop:bg-slate-900/60 backdrop:backdrop-blur-sm"}
  = form_with model: clearance, url: clear_request_logs_path, method: :post, html: {novalidate: true} do |form|
    %div{class: "space-y-5 p-6"}
      %div{class: "flex gap-4"}
        %div{class: "flex size-10 shrink-0 items-center justify-center rounded-full bg-red-100 text-red-600"}
          = icon("trash", size: 18)
        %div
          %h2{id: "clear-logs-title", class: "text-base font-semibold"} Clear request logs
          %p{id: "clear-logs-description", class: "mt-1 text-sm text-slate-600"}
            Permanently deletes every log from the start of the first day to the end of the last (IST).
            It runs in the background, so the list may take a moment to update.

      - if clearance.errors.any?
        = render "shared/error_summary", record: clearance, title: "#{pluralize(clearance.errors.count, "problem")} kept these logs from being cleared"

      %div{class: "grid gap-4 sm:grid-cols-2"}
        %div
          = form.label :from, class: label_class
          = form.date_field :from, class: input_class
        %div
          = form.label :to, class: label_class
          = form.date_field :to, class: input_class

      %div
        -# Indented by the box and gap (1rem + 0.75rem), so the hint lines up
        -# with the label it explains.
        %div{class: "flex flex-wrap items-center gap-x-3"}
          = form.check_box :local_only, aria: {describedby: "clear-logs-local-only-hint"},
            class: "size-4 shrink-0 rounded border-slate-300 accent-red-600"
          = form.label :local_only, class: "text-sm font-medium text-slate-700"
        %p{id: "clear-logs-local-only-hint", class: "mt-1 pl-7 text-xs text-slate-500"}
          Just requests to a local development server (localhost), which logs to
          this same database. Production logs in the range are kept.

    %div{class: "flex flex-col-reverse gap-2 border-t border-slate-200 bg-slate-50 px-6 py-4 sm:flex-row sm:justify-end"}
      %button{type: "button", data: {action: "modal#close"},
        class: "inline-flex items-center justify-center gap-1.5 rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 shadow-sm hover:bg-slate-50"}
        = icon("x", size: 14)
        Cancel
      = form.button type: "submit", name: nil,
        class: "inline-flex items-center justify-center gap-1.5 rounded-md bg-red-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-red-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-600" do
        = icon("trash", size: 14)
        Clear logs
