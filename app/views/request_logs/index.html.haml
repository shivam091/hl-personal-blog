- content_for :title, "Request logs"

%div{class: "mb-6 flex flex-wrap items-center justify-between gap-3"}
  %h1{class: "text-2xl font-semibold tracking-tight"} Request logs
  %div{class: "flex flex-wrap items-center gap-2",
    data: {controller: "modal", modal_open_value: @clearance.errors.any?.to_s, action: "turbo:before-cache@document->modal#close"}}
    = link_to list_url(@filtering, @sorting, format: :csv),
      class: "inline-flex items-center gap-1.5 rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 shadow-sm hover:bg-slate-50" do
      = icon("download", size: 14)
      Export CSV
    -# Styled like Export CSV so the toolbar reads as one set; the red icon
    -# and text flag that this one deletes.
    %button{type: "button", data: {action: "modal#open"}, aria: {haspopup: "dialog"},
      class: "inline-flex items-center gap-1.5 rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-red-700 shadow-sm hover:border-red-300 hover:bg-red-50"}
      = icon("trash", size: 14)
      Clear logs…
    = render "clear_dialog", clearance: @clearance

= search_panel @filtering, keep: [@sorting, @pagination]
= filter_tabs @filtering, counts: @tab_counts, keep: [@sorting, @pagination]

- if @pagination.total_count.zero?
  = render "shared/empty_state", message: (@filtering.filtered? ? "No requests match." : "No requests logged yet."),
    icon: (@filtering.filtered? ? "search" : "inbox")
- else
  -# The row checkboxes join this form through their form attribute, since
  -# each row's own delete button is a form and forms can't nest.
  %div{data: {controller: "bulk-select", bulk_select_one_value: "log", bulk_select_many_value: "logs",
    bulk_select_confirm_value: "Delete {items}? This can't be undone."}}
    = form_with url: destroy_selected_request_logs_path, method: :delete, id: "bulk-delete",
      class: "mb-3 flex items-center justify-between gap-3", data: {bulk_select_target: "form", turbo_confirm: "Delete the selected logs? This can't be undone."} do
      %p{class: "text-sm text-slate-600", aria: {live: "polite"}, data: {bulk_select_target: "count"}} No logs selected
      %button{type: "submit", disabled: true, data: {bulk_select_target: "submit"},
        class: "inline-flex items-center gap-1.5 rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-red-700 shadow-sm hover:border-red-300 hover:bg-red-50 disabled:cursor-not-allowed disabled:opacity-50 disabled:hover:border-slate-300 disabled:hover:bg-white"}
        = icon("trash", size: 14)
        Delete selected

    %div{class: "relative overflow-x-auto rounded-lg border border-slate-200 bg-white shadow-sm"}
      %table{class: "w-full border-collapse text-left text-sm"}
        %thead{class: "border-b border-slate-200 bg-slate-50 text-slate-600"}
          %tr
            %th{scope: "col", class: "w-0 py-2.5 pr-1 pl-3"}
              %input{type: "checkbox", class: "block size-4 rounded border-slate-300 accent-slate-900",
                aria: {label: "Select all logs on this page"},
                data: {bulk_select_target: "all", action: "bulk-select#toggleAll"}}
            %th{scope: "col", class: "px-3 py-2.5 text-right font-semibold", aria: {label: "Row number"}} #
            - sort_keep = [@filtering, @pagination]
            = sort_header @sorting, "Time", "created_at", keep: sort_keep, class: "px-3 py-2.5 font-semibold"
            = sort_header @sorting, "Request", "uri", keep: sort_keep, class: "px-3 py-2.5 font-semibold"
            = sort_header @sorting, "Status", "status", keep: sort_keep, class: "px-3 py-2.5 font-semibold"
            = sort_header @sorting, "Duration", "elapsed_time", keep: sort_keep, class: "px-3 py-2.5 text-right font-semibold"
            = sort_header @sorting, "Size", "response_size", keep: sort_keep, class: "px-3 py-2.5 text-right font-semibold"
            %th{scope: "col", class: "px-3 py-2.5 font-semibold"} Client
            %th{scope: "col", class: "px-3 py-2.5"}
              %span{class: "sr-only"} Actions
        %tbody
          - @request_logs.each.with_index(@pagination.first_item) do |log, number|
            %tr{class: "border-b border-slate-100 last:border-b-0 hover:bg-slate-50 has-checked:bg-slate-100"}
              %td{class: "py-2 pr-1 pl-3"}
                %input{type: "checkbox", name: "ids[]", value: log.id, form: "bulk-delete",
                  class: "block size-4 rounded border-slate-300 accent-slate-900",
                  aria: {label: "Select the log for #{log}"},
                  data: {bulk_select_target: "item", action: "bulk-select#update"}}
              %td{class: "px-3 py-2 text-right tabular-nums text-slate-500"}= number_with_delimiter(number)
              %td{class: "px-3 py-2 whitespace-nowrap text-slate-500"}
                - if log.created_at
                  %time{datetime: log.created_at.iso8601}= l(log.created_at)
              %td{class: "px-3 py-2"}
                %div{class: "inline-flex items-center gap-2"}
                  = http_method_badge(log.request_method)
                  = link_to log.path, request_log_path(log), class: "font-medium whitespace-nowrap text-slate-900 hover:underline"
                - if log.error?
                  %p{class: "mt-0.5 flex items-center gap-1 truncate pl-18 text-xs text-red-700"}
                    = icon("alert-circle", size: 12)
                    = log.exception["class"]
              %td{class: "px-3 py-2"}= status_badge(log.status)
              %td{class: "px-3 py-2 text-right whitespace-nowrap tabular-nums #{duration_class(log)}"}= duration(log)
              %td{class: "px-3 py-2 text-right whitespace-nowrap tabular-nums text-slate-600"}
                = log.response_size ? number_to_human_size(log.response_size) : "—"
              %td{class: "px-3 py-2"}
                %div{class: "font-mono text-xs text-slate-700"}= log.remote_address
                - if (location = ip_location(log.ip_info))
                  %div{class: "text-xs text-slate-500"}= location
              %td{class: "px-3 py-2 text-right"}
                = button_to request_log_path(log), method: :delete, title: "Delete",
                  form: {data: {turbo_confirm: "Delete the log for #{log}? This can't be undone."}},
                  class: "inline-flex rounded-md p-1.5 text-red-600 hover:bg-red-50 hover:text-red-700",
                  aria: {label: "Delete the log for #{log}"} do
                  = icon("trash")

= pagination_nav @pagination, keep: [@filtering, @sorting]
