!!!
-# Tables and inline styles, since that's all most mail clients render.
- font = "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif"
- gradient = "linear-gradient(135deg,#4f46e5 0%,#7c3aed 100%)"
- home = @home_url || blog_url || "#"
%html{lang: "en"}
  %head
    %meta{"http-equiv" => "Content-Type", content: "text/html; charset=utf-8"}
    %meta{name: "viewport", content: "width=device-width, initial-scale=1"}
    %meta{name: "color-scheme", content: "light"}
    %meta{name: "supported-color-schemes", content: "light"}
    %title= message.subject
    :css
      @media (max-width: 620px) {
        .mail-pad { padding-left: 24px !important; padding-right: 24px !important; }
        .mail-h1 { font-size: 23px !important; }
      }
  %body{style: "margin:0;padding:0;background:#f4f5fb;font-family:#{font};color:#0f172a;-webkit-font-smoothing:antialiased;"}
    -# Hidden, as it's only for the line inboxes show beside the subject; the
    -# filler keeps the body's first words from being pulled into that line.
    - if content_for?(:preheader)
      %div{style: "display:none;max-height:0;overflow:hidden;opacity:0;mso-hide:all;"}
        = yield(:preheader)
        = ("&#847;&zwnj;&nbsp;" * 60).html_safe
    %table{role: "presentation", width: "100%", cellpadding: 0, cellspacing: 0, style: "background:#f4f5fb;"}
      %tr
        %td{align: "center", style: "padding:40px 12px;"}
          %table{role: "presentation", width: "100%", cellpadding: 0, cellspacing: 0, style: "max-width:600px;"}
            %tr
              %td.mail-pad{style: "background:#4f46e5;background-image:#{gradient};border-radius:20px 20px 0 0;padding:40px 40px 34px;text-align:center;"}
                - if logo_url
                  -# Fixed width and height, as Outlook otherwise shows the
                  -# image at its full size; the white disc keeps the
                  -# transparent avatar legible on the gradient. No alt
                  -# text, since the name right below already says it.
                  %table{role: "presentation", align: "center", cellpadding: 0, cellspacing: 0, style: "margin:0 auto 16px;"}
                    %tr
                      %td{style: "width:76px;height:76px;padding:0;border-radius:50%;background:#ffffff;box-shadow:0 6px 18px rgba(15,23,42,0.22);text-align:center;vertical-align:middle;"}
                        %a{href: home, style: "display:block;text-decoration:none;"}
                          %img{src: logo_url, width: 60, height: 60, alt: "",
                            style: "display:block;width:60px;height:60px;margin:8px auto;border:0;outline:none;text-decoration:none;border-radius:50%;"}
                %a{href: home, style: "color:#ffffff;text-decoration:none;font-size:22px;font-weight:800;letter-spacing:-0.3px;"}
                  = blog_name
                %p{style: "margin:6px 0 0;color:#c7d2fe;font-size:12px;font-weight:600;letter-spacing:1.2px;text-transform:uppercase;"}
                  = ApplicationMailer::ROLES
                - if content_for?(:hero)
                  %p{style: "margin:20px 0 0;"}
                    %span{style: "display:inline-block;padding:8px 16px;border:1px solid rgba(255,255,255,0.3);border-radius:999px;background:rgba(255,255,255,0.14);color:#ffffff;font-size:14px;font-weight:600;"}= yield(:hero)
            %tr
              %td.mail-pad{style: "background:#ffffff;padding:44px 44px 40px;border-radius:0 0 20px 20px;font-size:16px;line-height:1.65;color:#334155;box-shadow:0 12px 32px rgba(15,23,42,0.06);"}
                = yield
            %tr
              %td{style: "padding:32px 16px 8px;text-align:center;"}
                - ApplicationMailer::SOCIAL_LINKS.each do |label, url|
                  %a{href: url, style: "display:inline-block;margin:0 4px 8px;padding:6px 14px;border:1px solid #e2e8f0;border-radius:999px;background:#ffffff;color:#475569;font-size:13px;font-weight:600;text-decoration:none;"}= label
            %tr
              %td{style: "padding:8px 24px 0;text-align:center;font-size:13px;line-height:1.7;color:#64748b;"}
                -# Why the reader got the mail, which inbox providers expect
                -# of anything that looks like bulk mail.
                - if content_for?(:footer_note)
                  %p{style: "margin:0;"}= yield(:footer_note)
                - if @unsubscribe_url
                  %p{style: "margin:4px 0 0;"}
                    Don't want these any more?
                    %a{href: @unsubscribe_url, style: "color:#4f46e5;text-decoration:underline;"} Unsubscribe
                %p{style: "margin:12px 0 0;color:#94a3b8;"} © #{Date.current.year} #{blog_name}
