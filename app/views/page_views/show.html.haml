- page_view = @page_view
- content_for :title, "#{page_view.slug} – Page views"

= link_to page_views_path, class: "mb-4 inline-flex items-center gap-1.5 text-sm font-medium text-slate-600 hover:text-slate-900" do
  = icon("arrow-left")
  Page views

%div{class: "mb-6"}
  %h1{class: "text-xl font-semibold tracking-tight break-all"}= page_view.slug
  %p{class: "mt-1 flex flex-wrap items-center gap-x-2 text-sm text-slate-500"}
    = blog_page_link(page_view.url, nil, truncate: true)
    - if page_view.updated_at
      %span ·
      %span
        Last updated
        = time_tag(page_view.updated_at)

= render "shared/stats", stats: page_view_stats(page_view)

= render "page_views/scorecard", page_view: page_view, page_like: @page_like, period: @period, granularity: @granularity, search: @search, ai: @ai, assistants: @assistants,
  analytics: @analytics, feed_entry: @feed_entry, crawled_page: @crawled_page

= render "page_views/speed", results: @page_speed

- if @launch_curve
  = render layout: "shared/card", locals: {id: "launch", title: "First #{LaunchCurve::DAYS} days", icon: "trending-up", class: "mb-6"} do
    - typical = @launch_curve.typical
    %p{class: lead_note_class}
      Views so far, day by day from publishing.
      - if typical
        Dashed is the median of #{pluralize(@launch_curve.typical_count, "earlier entry", plural: "earlier entries")} over their own first #{LaunchCurve::DAYS} days.
      - else
        Too few earlier entries with a full first #{LaunchCurve::DAYS} days to show a typical one yet.
    %div{class: "px-4 py-3"}
      = line_chart(@launch_curve.dates,
        [ChartsHelper::Series.new(name: "This entry", values: @launch_curve.views),
         (ChartsHelper::Series.new(name: "Typical entry", values: typical, dashed: true) if typical)].compact,
        y_title: "Views so far", label: "Running total of views of #{page_view.slug} over its first #{LaunchCurve::DAYS} days, beside the typical entry's")

%div{class: "grid items-start gap-6 lg:grid-cols-2"}
  = render layout: "shared/card", locals: {id: "period-devices", title: "Devices in the period", icon: "cpu"} do
    %div{class: "px-4 py-3"}
      = render "shared/breakdown", counts: page_view.devices_within(@period), heading: "Device", count_heading: "Views",
        empty: "No device data in this period."
  = render layout: "shared/card", locals: {id: "period-referrers", title: "Referrers in the period", icon: "log-in"} do
    %div{class: "px-4 py-3"}
      = render "shared/breakdown", counts: referrer_hosts(page_view.referrers_within(@period)), heading: "Referrer",
        count_heading: "Views", empty: "No referrer data in this period."

- consent = @page_consent
- if consent.any?
  - signed = ->(share) { "#{"−" if share.negative?}#{number_to_percentage(share.abs * 100, precision: 1)}" }
  = render layout: "shared/card", locals: {id: "page-vs-ga", title: "This page against GA", icon: "split", class: "mt-6"} do
    %p{class: lead_note_class}
      - if consent.percent
        - synced = pluralize(consent.page_gap.days_covered, "day")
        - if consent.percent.negative?
          GA counted #{number_to_percentage(-consent.percent * 100, precision: 1)} more views of this page than the blog over the #{synced} it has synced
        - else
          GA missed #{number_to_percentage(consent.percent * 100, precision: 1)} of this page's views over the #{synced} it has synced
        - if consent.median_percent
          (median across pages #{signed.(consent.median_percent)}).
        - if consent.flagged?
          %span{class: "ml-1 inline-block rounded bg-amber-100 px-1.5 py-0.5 text-xs font-medium whitespace-nowrap text-amber-800",
            title: "At least #{(PageGap::MARGIN * 100).round} points above the median, so this page is losing views for a reason of its own."}
            Well above the median
      - elsif consent.row
        Fewer than #{PageGap::MIN_VIEWS} views on the days GA has synced, too few to judge this page's gap.
      - else
        No views of this page on the days GA has synced, so its gap can't be judged.
    %div{class: "grid gap-6 px-4 py-3 lg:grid-cols-2"}
      %div{class: "min-w-0"}
        %p{class: "mb-2 text-xs font-medium text-slate-500"} Views by consent state
        = donut_chart(consent.states, label: "This page's views in the period by the reader's consent state", unit: "view",
          empty: "No consent recorded for this page in the period.")
      %div{class: "min-w-0"}
        %p{class: "mb-2 text-xs font-medium text-slate-500"} Where its gap goes
        - colors = ChartsHelper::SHARE_COLORS.cycle
        - parts = ConsentGap::CAUSES.map { |cause, name| [name, consent.causes[cause], colors.next] }
        - parts << ["Unexplained", consent.unexplained, ChartsHelper::SHARE_OTHER_COLOR] if consent.unexplained
        - parts = parts.select { |_, count, _| count.positive? }
        - total = parts.sum { |_, count, _| count }
        - if !consent.gap?
          %p{class: "text-sm text-slate-500"} GA counted as many of this page's views as the blog or more, so there's no gap to put down to causes.
        - elsif total.zero?
          %p{class: "text-sm text-slate-500"} Nothing on this page's synced days is put down to a cause.
        - else
          = swatch_legend(parts.map { |name, _, color| [name, color] })
          = share_bar(parts.map { |name, count, color| [name, count.fdiv(total), color, [{value: "#{number_with_delimiter(count)} #{"view".pluralize(count)} · #{number_to_percentage(count * 100.0 / total, precision: 1)}", name: name, color: color}]] },
            label: "What this page's gap with GA is put down to", height: "h-4")
        - if consent.gap?
          %p{class: "mt-2 text-xs text-slate-500"}
            Over the #{consent.days_explained} of #{pluralize(consent.days_compared, "day")} with views whose consent split is known, scaled as on
            the consent report: a blocked, undetected or datacentre view counts only for the share of readers GA could have seen.
            - if !consent.complete?
              The unexplained rest is left out until every day can be explained.
            - elsif !consent.unexplained
              The causes found add up to more than the gap, so none of it is left unexplained.
    %p{class: "flex justify-end border-t border-slate-200 px-4 py-2 text-xs"}
      = link_to consent_page_gap_report_path(**@period.query),
        class: "inline-flex items-center gap-1 font-medium text-slate-700 hover:text-slate-900 hover:underline" do
        Page gaps
        = icon("chevron-right", size: 14)

%h2{class: "mt-8 mb-3 text-sm font-semibold text-slate-700"} All time

%div{class: "grid items-start gap-6 lg:grid-cols-2"}
  = render layout: "shared/card", locals: {id: "views-by-day", title: "Views by day", icon: "clock"} do
    %div{class: "px-4 py-3"}
      = render "shared/daily_counts", by_day: page_view.views_by_day, countries_by_day: page_view.countries_by_day,
        count_heading: "Views", empty: "No daily views recorded."
  %div{class: "grid gap-6"}
    = render layout: "shared/card", locals: {id: "like-rate", title: "Likes per 100 views", icon: "heart"} do
      - if @like_rates["This page"].nil?
        %p{class: empty_note_class}
          Fewer than #{BlogStats::MIN_VIEWS_FOR_RATE} views so far, too few for a like rate.
      - else
        %div{class: "px-4 py-3"}
          = ranking_chart(@like_rates.compact.zip([[ChartsHelper::SHARE_SWATCHES[0], ChartsHelper::SHARE_COLORS[0]], [ChartsHelper::SHARE_OTHER_SWATCH, ChartsHelper::SHARE_OTHER_COLOR]]).map { |(name, rate), colors| [name, rate, *colors] },
            total: nil, x_title: "Likes per 100 views", y_title: "All time", label: "Likes per 100 views of this page, beside the site's average")
    = render layout: "shared/card", locals: {id: "countries", title: "Views by country", icon: "globe"} do
      %div{class: "px-4 py-3"}
        = render "shared/breakdown", counts: page_view.countries, heading: "Country", count_heading: "Views", empty: "No country data for this page."
    = render layout: "shared/card", locals: {id: "devices", title: "Devices", icon: "cpu"} do
      %div{class: "px-4 py-3"}
        = render "shared/breakdown", counts: page_view.devices, heading: "Device", count_heading: "Views", empty: "No device data for this page."
    = render layout: "shared/card", locals: {id: "referrers", title: "Referrers", icon: "log-in"} do
      %div{class: "px-4 py-3"}
        = render "shared/breakdown", counts: referrer_hosts(page_view.referrers), heading: "Referrer", count_heading: "Views", empty: "No referrer data for this page."
