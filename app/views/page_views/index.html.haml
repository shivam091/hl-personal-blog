- content_for :title, "Page views"

%div{class: "mb-6 flex flex-wrap items-center justify-between gap-3"}
  %h1{class: "text-2xl font-semibold tracking-tight"} Page views
  = link_to list_url(@period, @filtering, @sorting, format: :csv),
    class: "inline-flex items-center gap-1.5 rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 shadow-sm hover:bg-slate-50" do
    = icon("download", size: 14)
    Export CSV

-# All time unless a span is picked, so the list opens on the counts it
-# always showed; a span's counts come from each page's days.
%div{class: "mb-4 flex flex-wrap items-center gap-3"}
  = render "shared/period_presets", period: @period, keep: [@filtering, @sorting]
  = period_note @period, "Views in #{@period}; unique visitors aren't counted by day, so they're all time only."

= search_panel @filtering, keep: [@period, @sorting, @pagination]

- if @pagination.total_count.zero?
  = render "shared/empty_state", message: (@filtering.filtered? ? "No page views match." : "No page views yet."),
    icon: (@filtering.filtered? ? "search" : "inbox")
- else
  -# Beside the list's own counts, so a span's pages and where they were read read together.
  - if @country_views.values.any?(&:positive?)
    %div{class: "mb-6 grid items-start gap-6 lg:grid-cols-3"}
      = render layout: "shared/card", locals: {id: "page-views-map", title: "Views by country", icon: "globe", class: "lg:col-span-2"} do
        %div{class: "px-4 py-3"}
          = world_map(@country_views, label: "Views by country, shaded by views", unit: "view")
      = render layout: "shared/card", locals: {id: "page-views-countries", title: "Top countries", icon: "map-pin"} do
        %div{class: "px-4 py-3"}
          = render "shared/breakdown", counts: @country_views, heading: "Country", count_heading: "Views",
            empty: "No country data.", limit: 8
  %div{class: "relative overflow-x-auto rounded-lg border border-slate-200 bg-white shadow-sm"}
    %table{class: "w-full border-collapse text-left text-sm"}
      %thead{class: "border-b border-slate-200 bg-slate-50 text-slate-600"}
        %tr
          %th{scope: "col", class: "w-10 px-3 py-2.5"}
            %span{class: "sr-only"} Expand
          %th{scope: "col", class: "px-3 py-2.5 text-right font-semibold", aria: {label: "Row number"}} #
          - sort_keep = [@period, @filtering, @pagination]
          = sort_header @sorting, PageView.human_attribute_name(:url), "url", keep: sort_keep, class: "px-3 py-2.5 font-semibold"
          = visitor_headers @period, @sorting, keep: sort_keep
          = sort_header @sorting, PageView.human_attribute_name(:updated_at), "updated_at", keep: sort_keep, class: "px-3 py-2.5 font-semibold"

      - @page_views.each.with_index(@pagination.first_item) do |page_view, number|
        - details_id = dom_id(page_view, :details)
        %tbody{class: "border-b border-slate-100 last:border-b-0", data: {controller: "disclosure"}}
          %tr{class: "hover:bg-slate-50"}
            %td{class: "px-3 py-2"}
              %button{type: "button",
                class: "group inline-flex rounded p-1 text-slate-500 hover:bg-slate-100 hover:text-slate-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-400",
                aria: {expanded: "false", controls: details_id, label: "Show countries for #{page_view.url}"},
                data: {action: "disclosure#toggle", disclosure_target: "button"}}
                = icon("chevron-down", class: "transition-transform duration-150 group-aria-expanded:rotate-180")
            %td{class: "px-3 py-2 text-right tabular-nums text-slate-500"}= number_with_delimiter(number)
            %td{class: "px-3 py-2 font-medium whitespace-nowrap"}
              = render "shared/page_link", record: page_view, path: page_view_path(page_view, **@period.query)
            = visitor_cells page_view, @period
            %td{class: "px-3 py-2 whitespace-nowrap text-slate-500"}= time_or_dash(page_view.updated_at)
          %tr{id: details_id, hidden: true, class: "bg-slate-50", data: {disclosure_target: "panel"}}
            %td{colspan: 2}
            %td{colspan: page_view_details_colspan(@period), class: "px-3 pt-1 pb-4 whitespace-normal"}
              = render "shared/breakdown", counts: period_countries(page_view, @period), heading: "Country", count_heading: "Views",
                empty: "No country data for this page.", limit: 5
              = link_to page_view_path(page_view, **@period.query), class: "mt-3 inline-flex items-center gap-1 text-sm font-medium text-slate-700 hover:text-slate-900 hover:underline" do
                All details
                = icon("chevron-right", size: 14)

= pagination_nav @pagination, keep: [@period, @filtering, @sorting]
