- content_for :title, "Page likes"

%div{class: "mb-6 flex flex-wrap items-center justify-between gap-3"}
  %h1{class: page_title_class} Page likes
  = link_to list_url(@filtering, @sorting, format: :csv),
    class: outline_button_class do
    = icon("download", size: 14)
    Export CSV

= search_panel @filtering, keep: [@sorting, @pagination]

- if @pagination.total_count.zero?
  = render "shared/empty_state", message: (@filtering.filtered? ? "No page likes match." : "No page likes yet."),
    icon: (@filtering.filtered? ? "search" : "inbox")
- else
  %div{class: table_card_class}
    %table{class: "w-full border-collapse text-left text-sm"}
      %thead{class: table_head_class}
        %tr
          %th{scope: "col", class: "w-10 px-3 py-2.5"}
            %span{class: "sr-only"} Expand
          %th{scope: "col", class: list_heading_right_class, aria: {label: "Row number"}} #
          - sort_keep = [@filtering, @pagination]
          = sort_header @sorting, PageLike.human_attribute_name(:url), "url", keep: sort_keep, class: list_heading_class
          = sort_header @sorting, PageLike.human_attribute_name(:like_count), "like_count", keep: sort_keep, class: list_heading_right_class
          = sort_header @sorting, PageLike.human_attribute_name(:created_at), "created_at", keep: sort_keep, class: list_heading_class
          = sort_header @sorting, PageLike.human_attribute_name(:updated_at), "updated_at", keep: sort_keep, class: list_heading_class

      - @page_likes.each.with_index(@pagination.first_item) do |page_like, number|
        - details_id = dom_id(page_like, :details)
        %tbody{class: "border-b border-slate-100 last:border-b-0", data: {controller: "disclosure"}}
          %tr{class: "hover:bg-slate-50"}
            %td{class: "px-3 py-2"}
              %button{type: "button",
                class: "group inline-flex rounded p-1 text-slate-500 hover:bg-slate-100 hover:text-slate-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-400",
                aria: {expanded: "false", controls: details_id, label: "Show countries for #{page_like.url}"},
                data: {action: "disclosure#toggle", disclosure_target: "button"}}
                = icon("chevron-down", class: "transition-transform duration-150 group-aria-expanded:rotate-180")
            %td{class: muted_number_cell_class}= number_with_delimiter(number)
            %td{class: "px-3 py-2 font-medium whitespace-nowrap"}
              = render "shared/page_link", record: page_like, path: page_like_path(page_like)
            %td{class: "px-3 py-2 text-right tabular-nums"}= number_with_delimiter(page_like.like_count)
            - [page_like.created_at, page_like.updated_at].each do |time|
              %td{class: muted_cell_class}= time_or_dash(time)
          %tr{id: details_id, hidden: true, class: "bg-slate-50", data: {disclosure_target: "panel"}}
            %td{colspan: 2}
            %td{colspan: 4, class: "px-3 pt-1 pb-4 whitespace-normal"}
              = render "shared/breakdown", counts: page_like.countries, heading: "Country", count_heading: "Likes",
                empty: "No country data for this page.", limit: 5
              = link_to page_like_path(page_like), class: "mt-3 inline-flex items-center gap-1 text-sm font-medium text-slate-700 hover:text-slate-900 hover:underline" do
                All details
                = icon("chevron-right", size: 14)

= pagination_nav @pagination, keep: [@filtering, @sorting]
