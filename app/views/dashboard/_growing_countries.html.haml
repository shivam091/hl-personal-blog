-# Growth is each country against itself, so another country is no
-# baseline for it.
- shown = stats.period.compare? && !stats.period.compare_countries?
- rows = shown ? stats.fastest_growing_countries : []
= render layout: "shared/card", locals: {id: "growing-countries", title: "Fastest-growing countries", icon: "trending-up"} do
  - if !stats.period.compare?
    %p{class: "px-4 py-3 text-sm text-slate-500"}
      Growth is each country against its own earlier period, so this shows once a comparison is picked.
  - elsif stats.period.compare_countries?
    %p{class: "px-4 py-3 text-sm text-slate-500"}
      Each country is compared with its own period before, so this shows once comparing by period.
  - elsif rows.empty?
    %p{class: "px-4 py-3 text-sm text-slate-500"}
      No country reached #{BlogStats::MIN_VIEWS_FOR_GROWTH} views in this period.
  - else
    %div{class: "overflow-x-auto"}
      %table{class: "w-full border-collapse text-sm"}
        %thead{class: "text-slate-500"}
          %tr
            %th{scope: "col", class: "px-4 py-1.5 text-left font-medium"} Country
            %th{scope: "col", class: "px-4 py-1.5 text-right font-medium"} Views
        %tbody
          - rows.each do |code, count, before, _growth|
            %tr{class: "border-t border-slate-200"}
              %td{class: "px-4 py-1.5 font-medium"}
                = link_to country_label(code), list_url(@period, @country_metric, @granularity, country: code), class: "hover:underline"
              %td{class: "px-4 py-1.5 text-right tabular-nums whitespace-nowrap"}
                = number_with_delimiter(count)
                = row_change(count, before, DashboardHelper::HIGHER_IS_BETTER, force: true)
  %p{class: "border-t border-slate-200 px-4 py-2 text-xs text-slate-500", hidden: !shown}
    Compared with #{stats.period.previous}; only countries with #{BlogStats::MIN_VIEWS_FOR_GROWTH}+ views in this period.
