- pages = ranked_counts(stats.by_page(:views)).first(10)
- likes = stats.by_page(:likes)
- trends = stats.daily_by(:views, :slug)
- before = (stats.by_page(:views, stats.period.previous) if stats.period.compare?)
- before_likes = (stats.by_page(:likes, stats.period.previous) if before)
= render layout: "shared/card", locals: {id: "top-pages", title: "Top pages", icon: "file"} do
  - if pages.empty?
    %p{class: "px-4 py-3 text-sm text-slate-500"} No views in this period.
  - else
    %div{class: "overflow-x-auto"}
      %table{class: "w-full border-collapse text-sm"}
        %thead{class: "text-slate-500"}
          %tr
            %th{scope: "col", class: "px-4 py-1.5 text-left font-medium"} Page
            %th{scope: "col", class: "px-2 py-1.5 text-right font-medium"} Views
            %th{scope: "col", class: "px-2 py-1.5 text-right font-medium"} Likes
            %th{scope: "col", class: "px-4 py-1.5 text-right font-medium"} Trend
        %tbody
          - pages.each do |slug, count|
            %tr{class: "border-t border-slate-200"}
              %td{class: "w-full px-4 py-1.5"}
                = blog_page_link(slug, page_view_path(slug))
              %td{class: "px-2 py-1.5 text-right tabular-nums whitespace-nowrap"}
                = number_with_delimiter(count)
                = row_change(count, before.fetch(slug, 0), DashboardHelper::HIGHER_IS_BETTER) if before
              %td{class: "px-2 py-1.5 text-right tabular-nums whitespace-nowrap"}
                = number_with_delimiter(likes.fetch(slug, 0))
                = row_change(likes.fetch(slug, 0), before_likes.fetch(slug, 0), DashboardHelper::HIGHER_IS_BETTER) if before_likes
              %td{class: "px-4 py-1.5"}
                %div{class: "flex justify-end"}
                  = sparkline(trends[slug], label: "Views of #{slug} by day")
