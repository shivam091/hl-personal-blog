-# The map shows where readers are at a glance; the list beneath gives the
-# exact figures, which shades on a log scale can't. Always every country,
-# since it's what the country filter picks from.
- metric = country_metric.metric
- counts = stats.by_country(metric.to_sym)
= render layout: "shared/card", locals: {id: "countries", title: "Countries", icon: "globe"} do
  %nav{class: "flex gap-1 border-b border-slate-200 px-3 pt-2 text-xs", aria: {label: "Country metric"}}
    - DashboardController::COUNTRY_METRICS.each do |option|
      - current = option == metric
      = link_to option.humanize, list_url(@period, @filtering, by: option),
        class: ["-mb-px border-b-2 px-2 py-1.5", current ? "border-slate-900 font-medium text-slate-900" : "border-transparent text-slate-600 hover:text-slate-900"],
        aria: {current: (current ? "page" : nil)}
  %div{class: "px-4 py-3"}
    = world_map(counts, label: "#{metric.humanize} by country", unit: metric.singularize)
  %div{class: "border-t border-slate-200 px-4 py-3"}
    = render "shared/breakdown", counts: country_counts(counts),
      heading: "Country", count_heading: metric.humanize, empty: "None in this period.", limit: 10
