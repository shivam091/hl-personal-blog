-# By day once the frontend dates them, so they follow the period; until
-# then, and for views from before, only the pages' all-time totals exist,
-# so they fall back to those and say so. The frontend doesn't split them by
-# country, so a country filter doesn't narrow them.
- since = stats.breakdowns_tracked_since
- dated = since.present?
- devices = dated ? stats.devices : lifetime_totals(page_views, :devices)
- referrers = dated ? stats.referrers : lifetime_totals(page_views, :referrers)
- scope = dated ? "" : " · all time"
- notes = []
- notes << "Dated from #{l(since)}; earlier views are only in all-time totals." if dated && stats.period.from < since
- notes << "Every country." if dated && stats.country
- bots, humans = hits.values_at(:bots, :humans)
= render layout: "shared/card", locals: {id: "devices", title: "Devices#{scope}", icon: "cpu"} do
  %div{class: "px-4 py-3"}
    = donut_chart(devices, label: "Views by device#{scope}", unit: "view", empty: "No device data #{dated ? "in this period" : "yet"}.")
  %p{class: "border-t border-slate-200 px-4 py-2 text-xs text-slate-500"}
    = safe_join(notes, " ") if notes.any?
    Bots, all time: #{number_with_delimiter(bots)} of #{number_with_delimiter(bots + humans)} hits
    - if (bots + humans).positive?
      (#{number_to_percentage(bots * 100.0 / (bots + humans), precision: 1)}), kept out of every view count.
= render layout: "shared/card", locals: {id: "referrers", title: "Referrers#{scope}", icon: "log-in"} do
  %div{class: "px-4 py-3"}
    = render "shared/breakdown", counts: referrer_groups(referrers),
      heading: "Source", count_heading: "Views", empty: "No referrer data #{dated ? "in this period" : "yet"}."
  - if notes.any?
    %p{class: "border-t border-slate-200 px-4 py-2 text-xs text-slate-500"}= safe_join(notes, " ")
  - if (fixed_note = referrers_fixed_note(dated ? stats.period.from : Date.new(0)))
    %p{class: "border-t border-slate-200 px-4 py-2 text-xs text-amber-700"}= fixed_note
