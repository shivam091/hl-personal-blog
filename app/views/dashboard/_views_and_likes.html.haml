-# Two charts on one time axis rather than one chart with two scales, so
-# neither series' height is read against the other's axis. The period
-# compared with is drawn day for day under this one's, once picked, so a
-# change shows in shape.
- dates = (stats.period.from..stats.period.to).to_a
- before = stats.period.previous if stats.period.compare?
- views = stats.total(:views)
= render layout: "shared/card", locals: {id: "views-and-likes", title: "Views and likes", icon: "activity"} do
  %div{class: "space-y-4 px-4 py-3"}
    %div
      %p{class: "mb-1 text-xs font-medium text-slate-500"} Views per day
      = line_chart(dates, [ChartsHelper::Series.new(name: "This period", values: stats.daily(:views)),
        (ChartsHelper::Series.new(name: before.to_s, values: stats.daily(:views, before), dashed: true) if before)].compact,
        y_title: "Views", label: "Views per day#{", against #{before}" if before}", events: published, event_name: "Published")
    %div
      %p{class: "mb-1 flex justify-between text-xs font-medium text-slate-500"}
        %span Likes per day
        %span
          Like rate
          %span{class: "text-slate-900 tabular-nums"}
            = rate_or_dash(views >= BlogStats::MIN_VIEWS_FOR_RATE ? stats.total(:likes).to_f / views : nil)
      = time_chart(dates.zip(stats.daily(:likes)), y_title: "Likes", label: "Likes per day", events: published, event_name: "Published")
