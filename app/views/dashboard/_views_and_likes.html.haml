-# Two charts on one time axis rather than one chart with two scales, so
-# neither series' height is read against the other's axis. The period
-# compared with is drawn bucket for bucket under this one's, once picked, so
-# a change shows in shape.
- days = (stats.period.from..stats.period.to).to_a
- dates = granularity.dates(days)
- per = granularity.by
- before = stats.period.previous if stats.period.compare?
- views = stats.total(:views)
- events = granularity.events(published)
= render layout: "shared/card", locals: {id: "views-and-likes", title: "Views and likes", icon: "activity",
  actions: render("shared/chart_granularity", granularity: granularity, label: "Views and likes")} do
  %div{class: "space-y-4 px-4 py-3"}
    %div
      %p{class: "mb-1 text-xs font-medium text-slate-500"} Views per #{per}
      = line_chart(dates, [ChartsHelper::Series.new(name: "This period", values: granularity.sums(days, stats.daily(:views))),
        (ChartsHelper::Series.new(name: before.to_s, values: granularity.sums((before.from..before.to).to_a, stats.daily(:views, before)).first(dates.size), dashed: true,
          keys: granularity.dates((before.from..before.to).to_a).first(dates.size)) if before)].compact,
        y_title: "Views", label: "Views per #{per}#{", against #{before}" if before}", per: granularity.per, events: events, event_name: "Published",
        compare: before.present?)
    %div
      %p{class: "mb-1 flex justify-between text-xs font-medium text-slate-500"}
        %span Likes per #{per}
        %span
          Like rate
          %span{class: "text-slate-900 tabular-nums"}
            = rate_or_dash(views >= BlogStats::MIN_VIEWS_FOR_RATE ? stats.total(:likes).to_f / views : nil)
      = time_chart(dates.zip(granularity.sums(days, stats.daily(:likes))), y_title: "Likes", label: "Likes per #{per}", per: granularity.per,
        events: events, event_name: "Published", compare: before.present?)
