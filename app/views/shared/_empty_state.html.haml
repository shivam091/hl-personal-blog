-# One look for "nothing here" across lists, so an empty list reads as
-# deliberate rather than broken.
%div{class: "flex flex-col items-center gap-2 rounded-lg border border-dashed border-slate-300 bg-white px-4 py-10 text-center text-slate-500"}
  = icon(local_assigns.fetch(:icon, "inbox"), size: 28, class: "text-slate-300")
  %p= message
