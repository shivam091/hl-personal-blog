- heading = capture do
  = icon(local_assigns[:icon], class: "text-slate-400") if local_assigns[:icon]
  = title
%section{class: ["overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm", local_assigns[:class]], aria: {labelledby: id}}
  - if local_assigns[:actions]
    %div{class: "flex flex-wrap items-center justify-between gap-x-3 gap-y-1 border-b border-slate-200 bg-slate-50 px-4 py-1.5"}
      %h2{id: id, class: "flex items-center gap-2 py-1 text-sm font-semibold text-slate-700"}= heading
      = actions
  - else
    %h2{id: id, class: "flex items-center gap-2 border-b border-slate-200 bg-slate-50 px-4 py-2.5 text-sm font-semibold text-slate-700"}= heading
  = yield
