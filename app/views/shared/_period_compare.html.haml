-# What the figures are judged against, and on pages split by country which
-# country they're for, as menus beside the period, so the bar reads as one
-# row and each pick applies at once like a period does. A compared country
-# is picked inside the compare menu rather than in a list of its own, so
-# it can't be mistaken for the country being shown.
- filtering = local_assigns[:filtering]
- compare = local_assigns.fetch(:compare, true)
-# Where a page's own default isn't the previous period, picking it has to be
-# written into the link, as leaving it out would fall back to that default.
- explicit_previous = local_assigns.fetch(:explicit_previous, false)
- country_field = filtering&.fields&.first
- country = filtering&.values&.dig(:country)
- compares = Period::COMPARES.except(*("country" unless country_field))
- button_class = "group inline-flex items-center gap-1.5 rounded-md border border-slate-300 bg-white px-2.5 py-1 text-sm text-slate-700 shadow-sm hover:bg-slate-50 aria-expanded:bg-slate-50"
- menu_class = "absolute top-full z-20 mt-2 rounded-lg text-sm border border-slate-200 bg-white p-1.5 shadow-lg"
- link_class = "flex items-center justify-between gap-3 rounded-md px-3 py-2 hover:bg-slate-100"
- dropdown = {controller: "dropdown", action: "keydown->dropdown#closeWithKeyboard turbo:before-cache@document->dropdown#close"}
- base = period.query.merge(compare: nil, vs: nil, vs_from: nil, vs_to: nil, page: nil)
- states = [filtering, *keep]
- control_class = "h-9 w-full min-w-0 rounded-md border border-slate-300 bg-white px-3 text-sm text-slate-900 shadow-sm focus:border-slate-500 focus:ring-1 focus:ring-slate-500 focus:outline-none"
- compare_label = {"country" => "vs #{country_label(period.compare_country)}", "custom" => "vs custom range", "off" => "No comparison"}.fetch(period.compare) { "vs #{Period::COMPARES[period.compare].downcase_first}" }

- if compare
  %div{class: "relative inline-flex", data: dropdown}
    %button{type: "button", class: button_class, aria: {expanded: "false", controls: "period-compare", haspopup: "true"},
      data: {action: "dropdown#toggle", dropdown_target: "button"}}
      = icon("bar-chart", size: 14, class: "text-slate-400")
      %span{class: "sr-only"} Compare:
      = compare_label
      = icon("chevron-down", size: 14, class: "text-slate-400 transition-transform duration-150 group-aria-expanded:rotate-180")
    %div{id: "period-compare", hidden: true, data: {dropdown_target: "menu"}, class: "#{menu_class} w-72"}
      %ul
        - compares.except("custom", "country", "off").each_key do |key|
          - current = period.compare == key
          - compared = period.previous_with(key)
          %li
            = link_to list_url(*states, **base, compare: (key unless key == Period::DEFAULT_COMPARE && !explicit_previous)), aria: {current: (current ? "true" : nil)},
              class: [link_class, current ? "font-medium text-slate-900" : "text-slate-700"] do
              %span
                %span{class: "block"}= Period::COMPARES[key]
                %span{class: "block text-xs font-normal tabular-nums text-slate-500"}= compared.to_s
              = icon("check", size: 14, class: "text-slate-500") if current

      -# Picked dates open on the form, so the range compared with can be
      -# nudged rather than typed again; until then it starts on the dates the
      -# period before would use.
      - picking = period.compare_custom?
      - suggested = picking ? period.previous : period.previous_with(Period::DEFAULT_COMPARE)
      %div{data: {controller: "disclosure"}}
        %button{type: "button", aria: {expanded: picking.to_s, controls: "compare-custom"},
          class: ["group flex w-full items-center justify-between rounded-md px-3 py-2 hover:bg-slate-100", picking ? "font-medium text-slate-900" : "text-slate-700"],
          data: {action: "disclosure#toggle", disclosure_target: "button"}}
          %span{class: "text-left"}
            %span{class: "block"} Custom range…
            %span{class: "block text-xs font-normal tabular-nums text-slate-500"}= picking ? period.previous.to_s : "Any dates of your own"
          = icon("chevron-down", size: 14, class: "text-slate-400 transition-transform group-aria-expanded:rotate-180")
        %div{id: "compare-custom", hidden: !picking, class: "px-3 pt-1 pb-2", data: {disclosure_target: "panel"}}
          = form_with url: request.path, method: :get, class: "grid gap-2" do
            - states.compact.map(&:query).reduce({}, :merge).merge(base, compare: "custom").compact.each do |name, value|
              = hidden_field_tag name, value, id: nil
            = label_tag :vs_from, class: "grid gap-1 text-xs text-slate-500" do
              From
              = date_field_tag :vs_from, suggested.from, max: Date.current, required: true, class: control_class
            = label_tag :vs_to, class: "grid gap-1 text-xs text-slate-500" do
              To
              = date_field_tag :vs_to, suggested.to, max: Date.current, required: true, class: control_class
            %button{type: "submit", class: "inline-flex h-9 items-center justify-center rounded-md bg-slate-900 px-3 text-sm font-medium text-white shadow-sm hover:bg-slate-700"}
              Compare

      - if compares.key?("country")
        - comparing = period.compare_countries?
        -# Unknown isn't an audience, so it's left out as a baseline.
        - choices = country_field.options.reject { |_, code| code == BlogStats::UNKNOWN_COUNTRY }
        %div{data: {controller: "disclosure"}}
          %button{type: "button", aria: {expanded: comparing.to_s, controls: "compare-countries"},
            class: ["group flex w-full items-center justify-between rounded-md px-3 py-2 hover:bg-slate-100", comparing ? "font-medium text-slate-900" : "text-slate-700"],
            data: {action: "disclosure#toggle", disclosure_target: "button"}}
            %span{class: "text-left"}
              %span{class: "block"} Another country
              %span{class: "block text-xs font-normal text-slate-500"} Same dates, another audience
            = icon("chevron-down", size: 14, class: "text-slate-400 transition-transform group-aria-expanded:rotate-180")
          %ul{id: "compare-countries", hidden: !comparing, data: {disclosure_target: "panel"}, class: "max-h-60 overflow-y-auto pl-3"}
            - choices.each do |label, code|
              - current = comparing && period.compare_country == code
              %li
                = link_to list_url(*states, **base, compare: "country", vs: code), aria: {current: (current ? "true" : nil)},
                  class: [link_class, "py-1.5", current ? "font-medium text-slate-900" : "text-slate-700"] do
                  = label
                  = icon("check", size: 14, class: "text-slate-500") if current

      %div{class: "mt-1 border-t border-slate-100 pt-1"}
        - current = !period.compare?
        = link_to list_url(*states, **base, compare: "off"), aria: {current: (current ? "true" : nil)},
          class: [link_class, current ? "font-medium text-slate-900" : "text-slate-700"] do
          No comparison
          = icon("check", size: 14, class: "text-slate-500") if current

- if country_field
  %div{class: "relative inline-flex", data: dropdown}
    %button{type: "button", class: button_class, aria: {expanded: "false", controls: "period-country", haspopup: "true"},
      data: {action: "dropdown#toggle", dropdown_target: "button"}}
      = icon("globe", size: 14, class: "text-slate-400")
      %span{class: "sr-only"} Country:
      = country ? country_label(country) : country_field.blank_label
      = icon("chevron-down", size: 14, class: "text-slate-400 transition-transform duration-150 group-aria-expanded:rotate-180")
    %ul{id: "period-country", hidden: true, data: {dropdown_target: "menu"}, class: "#{menu_class} w-max min-w-full max-h-80 overflow-y-auto"}
      - [[country_field.blank_label, nil], *country_field.options].each do |label, code|
        - current = country == code
        %li
          = link_to list_url(*states, **period.query, country: code, page: nil), aria: {current: (current ? "true" : nil)},
            class: [link_class, current ? "font-medium text-slate-900" : "text-slate-700"] do
            = label
            = icon("check", size: 14, class: "text-slate-500") if current
