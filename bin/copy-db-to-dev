#!/usr/bin/env bash
# Exists so changes can be tried locally against real data without touching
# what the frontend serves.
set -euo pipefail

SOURCE_DB="${SOURCE_DB:-personal-blog}"
TARGET_DB="${TARGET_DB:-personal-blog-dev}"

for tool in mongodump mongorestore mongosh; do
  command -v "$tool" >/dev/null || { echo "$tool is not installed (MongoDB Database Tools / mongosh)." >&2; exit 1; }
done

cd "$(dirname "$0")/.."

# From the app's credentials unless given, so the password stays out of this
# file and the shell history. The source is the live Atlas database in the
# production credentials; the target is the local mongod development uses.
source_uri="${SOURCE_URI:-$(bin/rails runner 'print Rails.application.encrypted("config/credentials/production.yml.enc", key_path: "config/credentials/production.key").config.dig(:mongodb, :uri)')}"
if [[ -z "$source_uri" ]]; then
  echo "No source MongoDB URI: set SOURCE_URI or production credentials mongodb.uri." >&2
  exit 1
fi
# Atlas users authenticate against admin; see config/mongoid.yml for why the
# DNS default can't be relied on.
if [[ "$source_uri" != *authSource=* ]]; then
  [[ "$source_uri" == *\?* ]] && source_uri="$source_uri&authSource=admin" || source_uri="$source_uri?authSource=admin"
fi

target_uri="${TARGET_URI:-$(bin/rails runner 'print Rails.application.credentials.dig(:mongodb, :uri) || "mongodb://localhost:27017"')}"

# The target is dropped, so anything but a local mongod could be live data.
if [[ ! "$target_uri" =~ ^mongodb://(localhost|127\.0\.0\.1)(:[0-9]+)?(/|\?|$) ]]; then
  echo "Refusing to replace '$TARGET_DB' on '$target_uri': it is not a local mongod." >&2
  exit 1
fi

mongosh "$target_uri" --quiet --eval "db.runCommand({ ping: 1 })" >/dev/null 2>&1 ||
  { echo "Can't reach the local mongod at $target_uri; is it running?" >&2; exit 1; }

# Data and indexes, uncompressed, because that is what Atlas counts against
# the cluster's storage limit.
size_report='
  const human = bytes => {
    const units = ["B", "KB", "MB", "GB", "TB"];
    let i = 0;
    while (bytes >= 1024 && i < units.length - 1) { bytes /= 1024; i++; }
    return bytes.toFixed(i ? 1 : 0) + " " + units[i];
  };
  const names = target.getCollectionInfos({ type: "collection" }).map(c => c.name).sort();
  const row = (name, docs, data, indexes, size) =>
    print(name.padEnd(48), docs.padStart(10), data.padStart(10), indexes.padStart(10), size.padStart(10));
  let docs = 0, data = 0, indexes = 0;
  row("collection", "docs", "data", "indexes", "size");
  names.forEach(name => {
    const s = target.getCollection(name).aggregate([{ $collStats: { storageStats: {} } }]).next().storageStats;
    docs += s.count; data += s.size; indexes += s.totalIndexSize;
    row(name, String(s.count), human(s.size), human(s.totalIndexSize), human(s.size + s.totalIndexSize));
  });
  row("total", String(docs), human(data), human(indexes), human(data + indexes));
'

# Shown before the prompt, so the space the copy needs is known up front.
echo "== Live $SOURCE_DB =="
mongosh "$source_uri" --quiet --eval "const target = db.getSiblingDB('$SOURCE_DB'); $size_report"

if [[ "${1:-}" != "-y" ]]; then
  read -r -p "Replace every collection in local '$TARGET_DB' with a copy of live '$SOURCE_DB'? [y/N] " answer
  [[ "$answer" =~ ^[Yy]$ ]] || { echo "Nothing copied."; exit 0; }
fi

# Dropped first, so collections that exist only in dev don't survive and the
# copy is exact.
echo "== Dropping local $TARGET_DB =="
mongosh "$target_uri" --quiet --eval "db.getSiblingDB('$TARGET_DB').dropDatabase()" >/dev/null

# Streamed from one tool to the other, so no dump is left on disk; read from
# a secondary where possible, so the copy doesn't load the live primary.
echo "== Copying live $SOURCE_DB to local $TARGET_DB =="
mongodump --uri="$source_uri" --db="$SOURCE_DB" --readPreference=secondaryPreferred --archive --gzip --quiet |
  mongorestore --uri="$target_uri" --archive --gzip --nsInclude="$SOURCE_DB.*" --nsFrom="$SOURCE_DB.*" --nsTo="$TARGET_DB.*" --quiet

echo "== Local $TARGET_DB =="
mongosh "$target_uri" --quiet --eval "const target = db.getSiblingDB('$TARGET_DB'); $size_report"
