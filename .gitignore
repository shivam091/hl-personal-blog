/.bundle

/.env*
!/.env.sample

/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets

# They decrypt the credentials, so they never go in the repo.
/config/*.key
/config/credentials/*.key

/app/assets/builds/*
!/app/assets/builds/.keep

